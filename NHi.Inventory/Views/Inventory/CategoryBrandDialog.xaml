<Window x:Class="NHi.Inventory.Views.Inventory.CategoryBrandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add" Height="180" Width="350" WindowStartupLocation="CenterOwner"
        Background="White" ResizeMode="NoResize">
    <Border Padding="25">
        <StackPanel>
            <TextBlock x:Name="txtTitle" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,15"/>
            <TextBlock x:Name="lblName" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtName" FontSize="13" Padding="10,8" Margin="0,0,0,15"/>
            <Button Content="{DynamicResource Save}" Height="35" Click="BtnSave_Click"
                    Background="#1565C0" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>
