<Window x:Class="NHi.Inventory.Views.Inventory.UnitManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Unit Management" Height="520" Width="400" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LightBgBrush}" ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource UnitManagement}" FontSize="16" FontWeight="Bold"
                   Foreground="#1565C0" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="{DynamicResource UnitManagementHint}" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

        <TextBlock Grid.Row="2" x:Name="lblField" Text="{DynamicResource CustomUnitLabel}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtName" Grid.Column="0" FontSize="13" Padding="10,8" MaxLength="50" KeyDown="TxtName_KeyDown"/>
            <Button x:Name="btnAdd" Grid.Column="1" Content="{DynamicResource Add}" Click="BtnAdd_Click" Margin="8,0,0,0" Padding="16,8"
                    FontWeight="SemiBold" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="btnCancelEdit" Grid.Column="2" Content="{DynamicResource Cancel}" Click="BtnCancelEdit_Click" Margin="6,0,0,0"
                    Padding="12,8" Visibility="Collapsed" Style="{StaticResource SecondaryButton}"/>
        </Grid>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>

                                <Border Grid.Column="1" Background="{DynamicResource InfoBgBrush}" CornerRadius="6" Padding="7,2"
                                        VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{DynamicResource DefaultUnitBadge}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource InfoTextBrush}"/>
                                </Border>

                                <Button Grid.Column="2" Style="{StaticResource GhostIconButton}" Width="28" Height="28" Cursor="Hand"
                                        Click="BtnEditItem_Click" Tag="{Binding Id}" ToolTip="{DynamicResource Edit}">
                                    <materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" Foreground="{DynamicResource PrimaryBrush}"/>
                                </Button>
                                <Button Grid.Column="3" Width="28" Height="28" Cursor="Hand"
                                        Click="BtnDeleteItem_Click" Tag="{Binding Id}" ToolTip="{DynamicResource Delete}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostIconButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="{DynamicResource DangerTextBrush}"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="5" Content="{DynamicResource Close}" Height="36" Margin="0,15,0,0" Click="BtnClose_Click"
                Style="{StaticResource SecondaryButton}"/>
    </Grid>
</Window>
