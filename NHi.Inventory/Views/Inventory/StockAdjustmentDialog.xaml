<Window x:Class="NHi.Inventory.Views.Inventory.StockAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Adjustment" Height="560" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource CardBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBrush}">
        <Border Padding="25">
            <StackPanel>
                <TextBlock Text="{DynamicResource StockAdjustment}" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,15"/>

                <TextBlock Text="{DynamicResource Product}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtProductSearch" FontSize="13" Padding="10,8" Margin="0,0,0,4" TextChanged="TxtProductSearch_TextChanged"/>
                <ListBox x:Name="lstProductResults" MaxHeight="120" FontSize="12" Margin="0,0,0,10"
                         SelectionChanged="LstProductResults_SelectionChanged" Visibility="Collapsed"/>

                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock x:Name="txtSelectedProduct" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtCurrentStock" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="rbIncrease" Content="{DynamicResource IncreaseStock}" GroupName="AdjDirection"
                                 IsChecked="True" FontSize="13" Margin="0,0,20,0" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                    <RadioButton x:Name="rbDecrease" Content="{DynamicResource DecreaseStock}" GroupName="AdjDirection"
                                 FontSize="13" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource Quantity}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtQuantity" FontSize="16" Padding="12,10" Margin="0,0,0,12"/>

                <TextBlock Text="{DynamicResource AdjustmentReason}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbReason" FontSize="13" Padding="10,8" Margin="0,0,0,12" SelectedIndex="0">
                    <ComboBoxItem Content="{DynamicResource ReasonDamaged}" Tag="Damaged"/>
                    <ComboBoxItem Content="{DynamicResource ReasonLost}" Tag="Lost"/>
                    <ComboBoxItem Content="{DynamicResource ReasonCorrection}" Tag="Correction"/>
                    <ComboBoxItem Content="{DynamicResource Other}" Tag="Other"/>
                </ComboBox>

                <TextBlock Text="{DynamicResource Notes}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtNotes" FontSize="13" Padding="10,8" Margin="0,0,0,15"/>

                <Button Content="{DynamicResource Save}" Height="42" FontSize="14" FontWeight="SemiBold"
                        Click="BtnSave_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
