<Window x:Class="NHi.Inventory.Views.Admin.ShopUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shop Users" Height="560" Width="640" WindowStartupLocation="CenterOwner"
        MinHeight="400" MinWidth="500" Background="{DynamicResource CardBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="txtTitle" DockPanel.Dock="Left" Text="{DynamicResource ShopUsers}" FontSize="20" FontWeight="Bold"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource AddUser}" HorizontalAlignment="Right"
                    Click="BtnAdd_Click" Padding="15,7" Cursor="Hand" FontSize="12" Style="{StaticResource PrimaryButton}"/>
        </DockPanel>
        <DataGrid x:Name="dg" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" FontSize="13" CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="130"/>
                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{DynamicResource UserDetails}" FontSize="10" Background="Transparent" BorderThickness="0"
                                    Click="BtnViewDetails_Click" Tag="{Binding Id}" Cursor="Hand" Foreground="#1565C0" Padding="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
