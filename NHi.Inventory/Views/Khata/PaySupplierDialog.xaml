<Window x:Class="NHi.Inventory.Views.Khata.PaySupplierDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pay Supplier" Height="660" Width="400" MinHeight="420" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" Background="{DynamicResource CardBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBrush}">
        <Border Padding="25">
        <StackPanel>
            <TextBlock x:Name="txtTitle" Text="{DynamicResource PaySupplier}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock x:Name="txtSupplierName" FontSize="14" Margin="0,0,0,10"/>

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource CurrentPayableLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="txtCurrentBalance" Grid.Column="1" FontSize="14" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource NewBalance}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="txtNewBalancePreview" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource Amount}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtAmount" FontSize="18" Padding="12,10" Margin="0,0,0,12" TextChanged="TxtAmount_TextChanged"/>

            <TextBlock Text="{DynamicResource PaymentDate}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DatePicker x:Name="dpPaymentDate" Padding="8,6" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>

            <TextBlock Text="{DynamicResource PaymentMethod}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="cmbPaymentMethod" FontSize="13" Padding="10,8" Margin="0,0,0,12" SelectedIndex="0">
                <ComboBoxItem Content="{DynamicResource Cash}" Tag="Cash"/>
                <ComboBoxItem Content="{DynamicResource Bank}" Tag="Bank"/>
                <ComboBoxItem Content="{DynamicResource Card}" Tag="Card"/>
                <ComboBoxItem Content="{DynamicResource Other}" Tag="Other"/>
            </ComboBox>

            <TextBlock Text="{DynamicResource ReferenceNumber}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtReferenceNumber" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Notes}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtNotes" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <CheckBox x:Name="chkPrintReceipt" Content="{DynamicResource PrintReceipt}" FontSize="12" IsChecked="True" Margin="0,0,0,15"/>

            <Button Content="{DynamicResource Save}" Height="42" FontSize="14" FontWeight="SemiBold"
                    Click="BtnSave_Click" Style="{StaticResource SuccessButton}"/>
        </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
