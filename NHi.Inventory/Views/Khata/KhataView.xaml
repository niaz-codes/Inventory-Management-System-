<UserControl x:Class="NHi.Inventory.Views.Khata.KhataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tabs -->
        <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="{DynamicResource CustomerKhata}" FontSize="13" FontWeight="SemiBold" Padding="15,5"/>
                </TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Customer List -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtCustomerSearch" Grid.Column="0" FontSize="13" Padding="10,8"
                                     TextChanged="TxtCustomerSearch_TextChanged"/>
                            <Button Grid.Column="1" Content="{DynamicResource AddCustomer}" Padding="12,7" Margin="10,0,5,0"
                                    Click="BtnAddCustomer_Click" FontSize="12" Background="#1565C0" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="{DynamicResource AddSupplier}" Padding="12,7" Margin="5,0,0,0"
                                    Click="BtnAddSupplier_Click" FontSize="12" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Customer Ledger -->
                    <DataGrid x:Name="dgCustomerLedger" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0"
                              BorderBrush="#E0E0E0" BorderThickness="1" RowBackground="White" 
                              AlternatingRowBackground="#FAFAFA" FontSize="13" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="100"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="120"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat='Rs. {0:N0}'}" Width="100"/>
                            <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat='Rs. {0:N0}'}" Width="100"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='Rs. {0:N0}'}" Width="100"/>
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{DynamicResource ReceivePayment}" FontSize="10" Padding="5,3"
                                                Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" Cursor="Hand"
                                                Click="BtnReceivePayment_Click" Tag="{Binding CustomerId}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Balance Summary -->
                    <Border Grid.Row="2" Background="#1565C0" CornerRadius="0,0,10,10" Padding="15,10" Margin="0,-1,0,0">
                        <Grid>
                            <TextBlock x:Name="txtCustomerBalance" Text="Total Receivables: Rs. 0" 
                                       Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="{DynamicResource SupplierLedger}" FontSize="13" FontWeight="SemiBold" Padding="15,5"/>
                </TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgSupplierLedger" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0"
                              BorderBrush="#E0E0E0" BorderThickness="1" RowBackground="White" 
                              AlternatingRowBackground="#FAFAFA" FontSize="13" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="100"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="120"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat='Rs. {0:N0}'}" Width="100"/>
                            <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat='Rs. {0:N0}'}" Width="100"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='Rs. {0:N0}'}" Width="100"/>
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{DynamicResource MakePayment}" FontSize="10" Padding="5,3"
                                                Background="#FFF3E0" Foreground="#E65100" BorderThickness="0" Cursor="Hand"
                                                Click="BtnMakePayment_Click" Tag="{Binding SupplierId}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" Background="#FF9800" CornerRadius="0,0,10,10" Padding="15,10" Margin="0,-1,0,0">
                        <TextBlock x:Name="txtSupplierBalance" Text="Total Payables: Rs. 0" 
                                   Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
