<Window x:Class="NHi.Inventory.Views.Khata.MessageHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Message History" Height="520" Width="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LightBgBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <materialDesign:PackIcon Kind="History" Width="18" Height="18" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock Text="{DynamicResource MessageHistory}" FontSize="16" FontWeight="Bold" Foreground="#1565C0"/>
        </StackPanel>
        <TextBlock x:Name="txtSubtitle" Grid.Row="1" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="historyPanel"/>
        </ScrollViewer>

        <Button Grid.Row="3" Content="{DynamicResource Close}" Height="36" Margin="0,15,0,0" Click="BtnClose_Click"
                Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
    </Grid>
</Window>
