<Window x:Class="NHi.Inventory.Views.Khata.AddSupplierKhataEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Supplier Khata Entry" Height="480" Width="400" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource CardBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBrush}">
    <Border Padding="25">
        <StackPanel>
            <TextBlock Text="{DynamicResource AddKhataEntry}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock x:Name="txtSupplierName" FontSize="14" Margin="0,0,0,15"/>

            <TextBlock Text="{DynamicResource EntryType}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Margin="0,0,0,12">
                <RadioButton x:Name="rbDebit" Content="{DynamicResource ManualDebit}" GroupName="EntryType"
                             IsChecked="True" FontSize="13" Margin="0,0,0,6"/>
                <RadioButton x:Name="rbCredit" Content="{DynamicResource ManualCredit}" GroupName="EntryType"
                             FontSize="13"/>
            </StackPanel>

            <TextBlock Text="{DynamicResource Amount}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtAmount" FontSize="16" Padding="12,10" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Description}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtDescription" FontSize="13" Padding="10,8" Margin="0,0,0,12" TextWrapping="Wrap" AcceptsReturn="True" Height="55"/>

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock x:Name="txtCreatedBy" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="txtCreatedAt" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Button Content="{DynamicResource Save}" Height="42" FontSize="14" FontWeight="SemiBold"
                    Click="BtnSave_Click" Style="{StaticResource SuccessButton}"/>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>
