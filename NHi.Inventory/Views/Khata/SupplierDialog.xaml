<Window x:Class="NHi.Inventory.Views.Khata.SupplierDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Supplier" Height="680" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource CardBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBrush}">
    <Border Padding="25">
        <StackPanel>
            <TextBlock x:Name="txtTitle" Text="{DynamicResource AddSupplier}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

            <TextBlock Text="{DynamicResource SupplierName}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtName" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource CompanyName}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtCompanyName" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource ContactPerson}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtContact" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Phone}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtPhone" FontSize="13" Padding="10,8"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource WhatsAppNumber}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtWhatsApp" FontSize="13" Padding="10,8"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Address}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtAddress" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <TextBlock x:Name="lblOpeningBalance" Text="{DynamicResource OpeningBalance}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtOpeningBalance" FontSize="13" Padding="10,8" Text="0" Margin="0,0,0,15"/>

            <CheckBox x:Name="chkActive" Content="{DynamicResource Active}" FontSize="13" IsChecked="True" Margin="0,0,0,18"/>

            <Button Content="{DynamicResource Save}" Height="40" Click="BtnSave_Click" Style="{StaticResource SuccessButton}"/>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>
