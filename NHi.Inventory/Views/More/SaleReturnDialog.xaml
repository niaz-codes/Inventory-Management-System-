<Window x:Class="NHi.Inventory.Views.More.SaleReturnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sale Return" Height="420" Width="400" WindowStartupLocation="CenterOwner"
        Background="White" ResizeMode="NoResize">
    <Border Padding="25">
        <StackPanel>
            <TextBlock x:Name="txtTitle" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,15"/>

            <TextBlock Text="{DynamicResource Product}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="cmbProduct" DisplayMemberPath="DisplayName" Padding="8,6" Margin="0,0,0,12"
                      SelectionChanged="CmbProduct_SelectionChanged"/>

            <TextBlock x:Name="txtAvailable" FontSize="11" Foreground="#757575" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Quantity}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtQuantity" FontSize="13" Padding="10,8" Margin="0,0,0,12" TextChanged="TxtQuantity_Changed"/>

            <TextBlock Text="{DynamicResource Notes}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtReason" FontSize="13" Padding="10,8" Margin="0,0,0,15"/>

            <TextBlock x:Name="txtRefundPreview" FontSize="13" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,15"/>

            <Button Content="{DynamicResource Return}" Height="40" Click="BtnSave_Click"
                    Background="#F44336" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>
