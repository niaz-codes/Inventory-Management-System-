<UserControl x:Class="NHi.Inventory.Views.More.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource SalesHistory}" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtSearch" Grid.Column="0" FontSize="12" Padding="8,6" Margin="0,0,10,0"
                     TextChanged="TxtSearch_TextChanged" Tag="{DynamicResource SearchInvoiceCustomer}"/>
            <TextBlock Grid.Column="1" Text="From" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
            <DatePicker x:Name="dpFrom" Grid.Column="2" FontSize="12"/>
            <TextBlock Grid.Column="3" Text="To" VerticalAlignment="Center" FontSize="12" Margin="15,0,8,0"/>
            <DatePicker x:Name="dpTo" Grid.Column="4" FontSize="12"/>
            <Button Grid.Column="5" Content="{DynamicResource Filter}" Click="BtnFilter_Click" Padding="12,6" Margin="15,0,5,0" FontSize="12" Style="{StaticResource PrimaryButton}"/>
            <Button Grid.Column="6" Content="{DynamicResource ExportToExcel}" Click="BtnExport_Click" Padding="12,6" FontSize="12"
                    Background="{DynamicResource SuccessBgBrush}" Foreground="{StaticResource SuccessBrush}" BorderThickness="0"/>
        </Grid>
        <DataGrid x:Name="dg" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" FontSize="13" CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="130"/>
                <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="100"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat='Rs. {0:N0}'}" Width="100"/>
                <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat='Rs. {0:N0}'}" Width="100"/>
                <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAmount, StringFormat='Rs. {0:N0}'}" Width="100"/>
                <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="80"/>
                <DataGridTemplateColumn Header="Actions" Width="280">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource ViewSale}" Click="BtnViewSale_Click" Tag="{Binding}"
                                        Padding="8,4" Margin="0,0,5,0" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                                <Button Content="{DynamicResource Reprint}" Click="BtnReprint_Click" Tag="{Binding}"
                                        Padding="8,4" Margin="0,0,5,0" Background="{DynamicResource InfoBgBrush}" Foreground="{DynamicResource InfoTextBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                                <Button Content="{DynamicResource Return}" Click="BtnReturn_Click" Tag="{Binding}"
                                        Padding="8,4" Margin="0,0,5,0" Background="{DynamicResource WarningBgBrush}" Foreground="{StaticResource WarningBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                                <Button Content="{DynamicResource Void}" Click="BtnVoid_Click" Tag="{Binding}"
                                        Padding="8,4" Background="{DynamicResource DangerBgBrush}" Foreground="{StaticResource DangerBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
