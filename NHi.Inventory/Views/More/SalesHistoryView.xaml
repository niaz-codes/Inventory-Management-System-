<UserControl x:Class="NHi.Inventory.Views.More.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource SalesHistory}" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="From" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
            <DatePicker x:Name="dpFrom" Grid.Column="1" FontSize="12"/>
            <TextBlock Grid.Column="2" Text="To" VerticalAlignment="Center" FontSize="12" Margin="15,0,8,0"/>
            <DatePicker x:Name="dpTo" Grid.Column="3" FontSize="12"/>
            <Button Grid.Column="4" Content="{DynamicResource Filter}" Click="BtnFilter_Click" Padding="12,6" Margin="15,0,5,0" Background="#1565C0" Foreground="White" BorderThickness="0" FontSize="12"/>
            <Button Grid.Column="5" Content="{DynamicResource ExportToExcel}" Click="BtnExport_Click" Padding="12,6" Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" FontSize="12"/>
        </Grid>
        <DataGrid x:Name="dg" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13" CanUserAddRows="False"
                  HeadersVisibility="Column" RowBackground="White" AlternatingRowBackground="#FAFAFA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="130"/>
                <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="100"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat='Rs. {0:N0}'}" Width="100"/>
                <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat='Rs. {0:N0}'}" Width="100"/>
                <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAmount, StringFormat='Rs. {0:N0}'}" Width="100"/>
                <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="80"/>
                <DataGridTemplateColumn Header="Actions" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Reprint}" Click="BtnReprint_Click" Tag="{Binding}"
                                        Padding="8,4" Margin="0,0,5,0" Background="#E3F2FD" Foreground="#1565C0" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                                <Button Content="{DynamicResource Return}" Click="BtnReturn_Click" Tag="{Binding}"
                                        Padding="8,4" Margin="0,0,5,0" Background="#FFF3E0" Foreground="#E65100" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                                <Button Content="{DynamicResource Void}" Click="BtnVoid_Click" Tag="{Binding}"
                                        Padding="8,4" Background="#FFEBEE" Foreground="#C62828" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
