<UserControl x:Class="NHi.Inventory.Views.More.DailyClosingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel MaxWidth="500" HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource DailyClosing}" FontSize="22" FontWeight="Bold" Margin="0,10,0,20"/>
            <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource OpeningCash}" FontSize="13" Foreground="#757575"/>
                        <TextBlock x:Name="txtOpening" Grid.Column="1" Text="Rs. 0" FontSize="14" FontWeight="SemiBold"/></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource CashSales}" FontSize="13" Foreground="#757575"/>
                        <TextBlock x:Name="txtCashSales" Grid.Column="1" Text="Rs. 0" FontSize="14" FontWeight="SemiBold"/></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource CreditSales}" FontSize="13" Foreground="#757575"/>
                        <TextBlock x:Name="txtCreditSales" Grid.Column="1" Text="Rs. 0" FontSize="14" FontWeight="SemiBold"/></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource CustomerPayments}" FontSize="13" Foreground="#757575"/>
                        <TextBlock x:Name="txtCustPayments" Grid.Column="1" Text="Rs. 0" FontSize="14" FontWeight="SemiBold"/></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Purchases}" FontSize="13" Foreground="#757575"/>
                        <TextBlock x:Name="txtPurchases" Grid.Column="1" Text="Rs. 0" FontSize="14" FontWeight="SemiBold"/></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Expenses}" FontSize="13" Foreground="#757575"/>
                        <TextBlock x:Name="txtExpenses" Grid.Column="1" Text="Rs. 0" FontSize="14" FontWeight="SemiBold"/></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource SupplierPayments}" FontSize="13" Foreground="#757575"/>
                        <TextBlock x:Name="txtSupPayments" Grid.Column="1" Text="Rs. 0" FontSize="14" FontWeight="SemiBold"/></Grid>
                    <Separator Margin="0,8"/>
                    <Grid Margin="0,8,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource ExpectedClosing}" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="txtExpected" Grid.Column="1" Text="Rs. 0" FontSize="16" FontWeight="Bold" Foreground="#1565C0"/></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource NetProfit}" FontSize="14" FontWeight="SemiBold" Foreground="#4CAF50"/>
                        <TextBlock x:Name="txtProfit" Grid.Column="1" Text="Rs. 0" FontSize="14" FontWeight="Bold" Foreground="#4CAF50"/></Grid>
                    <TextBlock Text="Actual Closing Cash" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtActualClosing" FontSize="14" Padding="10,8" Margin="0,0,0,15"/>
                    <TextBlock x:Name="txtDiff" Text="" FontSize="12" Foreground="#F44336" Margin="0,0,0,10"/>
                    <Button Content="{DynamicResource CloseDay}" Height="42" FontSize="14" FontWeight="SemiBold"
                            Click="BtnCloseDay_Click" Background="#F44336" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="{DynamicResource ExportToExcel}" Height="38" Margin="0,10,0,0" FontSize="13"
                            Click="BtnExport_Click" Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
