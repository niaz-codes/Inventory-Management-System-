<Window x:Class="NHi.Inventory.Views.More.AddDueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Due" Height="300" Width="380" WindowStartupLocation="CenterOwner"
        Background="White" ResizeMode="NoResize">
    <Border Padding="25">
        <StackPanel>
            <TextBlock x:Name="txtTitle" Text="{DynamicResource AddDue}" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,15"/>

            <TextBlock Text="{DynamicResource Amount}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtAmount" FontSize="16" Padding="12,10" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Description}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtDescription" FontSize="13" Padding="10,8" Margin="0,0,0,15"/>

            <Button Content="{DynamicResource Save}" Height="40" FontSize="14" FontWeight="SemiBold"
                    Click="BtnSave_Click" Background="#1565C0" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>
