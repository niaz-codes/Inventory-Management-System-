<Window x:Class="NHi.Inventory.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NHi.Inventory.Views"
        xmlns:viewsPOS="clr-namespace:NHi.Inventory.Views.POS"
        xmlns:viewsInv="clr-namespace:NHi.Inventory.Views.Inventory"
        xmlns:viewsKhata="clr-namespace:NHi.Inventory.Views.Khata"
        xmlns:viewsMore="clr-namespace:NHi.Inventory.Views.More"
        xmlns:viewsReports="clr-namespace:NHi.Inventory.Views.Reports"
        xmlns:viewsSettings="clr-namespace:NHi.Inventory.Views.Settings"
        Title="NHi Inventory Management System" 
        Height="780" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinHeight="700" MinWidth="1100"
        Background="#F5F7FA">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{x:Static views:MainWindowCommands.NewSaleCommand}"/>
        <KeyBinding Key="F2" Command="{x:Static views:MainWindowCommands.SearchProductCommand}"/>
        <KeyBinding Key="F9" Command="{x:Static views:MainWindowCommands.PrintCommand}"/>
        <KeyBinding Key="F10" Command="{x:Static views:MainWindowCommands.CompleteSaleCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#1565C0" Padding="15,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#0D47A1" Margin="0,0,10,0">
                        <TextBlock Text="NHi" FontSize="12" FontWeight="Bold" Foreground="White" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="NHi Inventory" FontSize="16" FontWeight="Bold" Foreground="White" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- User Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtCurrentUser" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtUserRole" Foreground="#BBDEFB" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="☰" FontSize="18" Background="Transparent" Foreground="White" 
                            BorderThickness="0" Cursor="Hand" Padding="8,2" Click="BtnMenu_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="8,4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#0D47A1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Width="70" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,5,0,0">
                    <!-- Home -->
                    <RadioButton x:Name="navHome" IsChecked="True" GroupName="Nav" Cursor="Hand" 
                                 Click="Nav_Click" Tag="Home" Margin="0,5,0,0">
                        <StackPanel HorizontalAlignment="Center" Width="60">
                            <TextBlock Text="🏠" FontSize="22" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="{DynamicResource NavHome}" FontSize="10" HorizontalAlignment="Center" 
                                       Foreground="#757575" Margin="0,2,0,6" FontWeight="SemiBold"/>
                        </StackPanel>
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bd" Background="Transparent" Padding="0,3">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <!-- POS -->
                    <RadioButton x:Name="navPOS" GroupName="Nav" Cursor="Hand" Click="Nav_Click" Tag="POS" Margin="0,5,0,0">
                        <StackPanel HorizontalAlignment="Center" Width="60">
                            <TextBlock Text="🛒" FontSize="22" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="{DynamicResource NavPOS}" FontSize="10" HorizontalAlignment="Center" 
                                       Foreground="#757575" Margin="0,2,0,6" FontWeight="SemiBold"/>
                        </StackPanel>
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bd" Background="Transparent" Padding="0,3">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <!-- Inventory -->
                    <RadioButton x:Name="navInventory" GroupName="Nav" Cursor="Hand" Click="Nav_Click" Tag="Inventory" Margin="0,5,0,0">
                        <StackPanel HorizontalAlignment="Center" Width="60">
                            <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="{DynamicResource NavInventory}" FontSize="10" HorizontalAlignment="Center" 
                                       Foreground="#757575" Margin="0,2,0,6" FontWeight="SemiBold"/>
                        </StackPanel>
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bd" Background="Transparent" Padding="0,3">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <!-- Khata -->
                    <RadioButton x:Name="navKhata" GroupName="Nav" Cursor="Hand" Click="Nav_Click" Tag="Khata" Margin="0,5,0,0">
                        <StackPanel HorizontalAlignment="Center" Width="60">
                            <TextBlock Text="📒" FontSize="22" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="{DynamicResource NavKhata}" FontSize="10" HorizontalAlignment="Center" 
                                       Foreground="#757575" Margin="0,2,0,6" FontWeight="SemiBold"/>
                        </StackPanel>
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bd" Background="Transparent" Padding="0,3">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <!-- More -->
                    <RadioButton x:Name="navMore" GroupName="Nav" Cursor="Hand" Click="Nav_Click" Tag="More" Margin="0,5,0,0">
                        <StackPanel HorizontalAlignment="Center" Width="60">
                            <TextBlock Text="☰" FontSize="22" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="{DynamicResource NavMore}" FontSize="10" HorizontalAlignment="Center" 
                                       Foreground="#757575" Margin="0,2,0,6" FontWeight="SemiBold"/>
                        </StackPanel>
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bd" Background="Transparent" Padding="0,3">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <!-- Spacer -->
                    <Border Height="20"/>

                    <!-- Logout -->
                    <Button Cursor="Hand" Click="BtnLogout_Click" Margin="0,5,0,10">
                        <StackPanel HorizontalAlignment="Center" Width="60">
                            <TextBlock Text="🚪" FontSize="20" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="{DynamicResource Logout}" FontSize="10" HorizontalAlignment="Center" 
                                       Foreground="#F44336" Margin="0,2,0,6" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" Padding="0,3">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FFEBEE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <ContentControl x:Name="mainContent" Grid.Column="1" Margin="0" x:FieldModifier="public"/>
        </Grid>
    </Grid>
</Window>
