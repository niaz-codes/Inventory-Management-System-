<Window x:Class="NHi.Inventory.Views.POS.CustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Customer" Height="450" Width="400" WindowStartupLocation="CenterOwner"
        Background="White" ResizeMode="NoResize">
    <Border Padding="25">
        <StackPanel>
            <TextBlock Text="{DynamicResource AddCustomer}" FontSize="18" FontWeight="Bold" 
                       Foreground="#1565C0" Margin="0,0,0,20"/>

            <TextBlock Text="{DynamicResource CustomerName}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtName" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource FatherName}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtFatherName" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Phone}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtPhone" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Address}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtAddress" FontSize="13" Padding="10,8" Margin="0,0,0,15"/>

            <Button Content="{DynamicResource Save}" Height="40" FontSize="14" FontWeight="SemiBold"
                    Click="BtnSave_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#4CAF50"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#388E3C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</Window>
