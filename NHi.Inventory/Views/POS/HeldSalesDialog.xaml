<Window x:Class="NHi.Inventory.Views.POS.HeldSalesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Held Sales" Height="420" Width="450" WindowStartupLocation="CenterOwner"
        Background="White" ResizeMode="NoResize">
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="{DynamicResource HoldSale}" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,15"/>
            <ListView x:Name="lv" Height="300" BorderBrush="#E0E0E0" BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Customer" DisplayMemberBinding="{Binding CustomerName}" Width="130"/>
                        <GridViewColumn Header="Items" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Items.Count}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Total" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Total, StringFormat='Rs. {0:N0}'}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Held At" DisplayMemberBinding="{Binding HeldAt, StringFormat='{}{0:hh:mm tt}'}" Width="70"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Delete}" Width="90" Height="36" Margin="0,0,10,0" Click="BtnDelete_Click"
                        Background="#FFEBEE" Foreground="#C62828" BorderThickness="0" Cursor="Hand"/>
                <Button Content="{DynamicResource ResumeSale}" Width="90" Height="36" Click="BtnResume_Click"
                        Background="#1565C0" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
