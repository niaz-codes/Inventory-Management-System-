<Window x:Class="NHi.Inventory.Views.POS.ReceiptActionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Receipt" Height="480" Width="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LightBgBrush}" ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitle" Grid.Row="0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock x:Name="txtCustomer" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="txtSubtitle" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <Button x:Name="btnPrint" Height="42" Margin="0,0,0,8" Click="BtnPrint_Click" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource PrintReceiptBtn}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnWhatsApp" Height="42" Margin="0,0,0,8" Click="BtnWhatsApp_Click"
                    Background="#25D366" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Whatsapp" Width="18" Height="18" Margin="0,0,8,0" Foreground="White"/>
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{DynamicResource WhatsAppReceiptBtn}" Foreground="White"/>
            </Button>
            <Button x:Name="btnPrintAndSend" Height="42" Click="BtnPrintAndSend_Click" Style="{StaticResource SuccessButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Whatsapp" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource PrintAndSendBtn}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <TextBlock Text="{DynamicResource ExportReceipt}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
            <UniformGrid Rows="1" Columns="4">
                <Button Content="PDF" Tag="Pdf" Click="BtnExport_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="0,7"/>
                <Button Content="Excel" Tag="Excel" Click="BtnExport_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="0,7"/>
                <Button Content="CSV" Tag="Csv" Click="BtnExport_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="0,7"/>
                <Button Content="PNG" Tag="Png" Click="BtnExport_Click" Style="{StaticResource SecondaryButton}" Padding="0,7"/>
            </UniformGrid>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="statusPanel"/>
        </ScrollViewer>

        <Button Grid.Row="4" Content="{DynamicResource Close}" Height="36" Margin="0,15,0,0" Click="BtnClose_Click"
                Style="{StaticResource SecondaryButton}"/>
    </Grid>
</Window>
