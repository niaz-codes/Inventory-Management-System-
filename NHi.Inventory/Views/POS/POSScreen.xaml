<UserControl x:Class="NHi.Inventory.Views.POS.POSScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             PreviewKeyDown="POSScreen_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="ProductCardBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="155"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.05" Color="#000"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CartBtn" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CategoryFilterBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CartStepperBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CartCellTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style x:Key="CartCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- One row in the customer search results popup, and the "+ Add New Customer" row
             appended below it - a plain flat button so the whole row is clickable. -->
        <Style x:Key="CustomerResultBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Products area flexes; the cart has a fixed, user-draggable pixel width. -->
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="cartColumn" Width="420" MinWidth="360" MaxWidth="640"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Products -->
        <Border Grid.Column="0" Background="{DynamicResource LightBgBrush}" Padding="10">
            <DockPanel>
                <!-- Customer Bar -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="14,10" Margin="0,0,0,10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="1" Opacity="0.05" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Customer}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- Search state: shown while no customer is attached to the sale (walk-in). -->
                        <Grid x:Name="pnlCustomerSearch" Grid.Column="1" Margin="0,0,10,0">
                            <TextBox x:Name="txtCustomerSearch" FontSize="13" Padding="8,5" VerticalContentAlignment="Center"
                                     Tag="{DynamicResource SearchCustomers}" TextChanged="TxtCustomerSearch_TextChanged"
                                     GotFocus="TxtCustomerSearch_GotFocus" PreviewKeyDown="TxtCustomerSearch_PreviewKeyDown"
                                     PreviewMouseLeftButtonUp="TxtCustomerSearch_PreviewMouseLeftButtonUp"/>
                            <Popup x:Name="popupCustomerResults" PlacementTarget="{Binding ElementName=txtCustomerSearch}"
                                   Placement="Bottom" Width="340" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" MaxHeight="400" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" Color="#000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="336" Margin="2">
                                            <ItemsControl x:Name="lstCustomerResults">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Click="CustomerResult_Click" Tag="{Binding}" Style="{StaticResource CustomerResultBtn}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                    <TextBlock Text="{Binding Phone}" FontSize="11"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding BalanceText}" FontSize="12" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" Foreground="{Binding BalanceBrush}"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock x:Name="txtNoCustomerResults" Text="{DynamicResource NoCustomerFound}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,8" Visibility="Collapsed"/>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="2,0">
                                            <Button Click="BtnAddCustomer_Click" Style="{StaticResource CustomerResultBtn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" Foreground="{StaticResource SuccessBrush}"
                                                                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource AddNewCustomer}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource SuccessBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Selected state: shown once a customer is attached to the sale. -->
                        <Border x:Name="pnlCustomerSelected" Grid.Column="1" Margin="0,0,10,0" Visibility="Collapsed"
                                Background="{DynamicResource InfoBgBrush}" CornerRadius="8" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountCircle" Width="20" Height="20" VerticalAlignment="Center"
                                                              Foreground="{StaticResource InfoBrush}" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock x:Name="txtSelectedCustomerName" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="txtSelectedCustomerPhone" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Width="26" Height="26" Cursor="Hand" Click="BtnChangeCustomer_Click"
                                        Background="Transparent" BorderThickness="0" ToolTip="{DynamicResource ChangeCustomer}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <Button Grid.Column="2" Width="30" Height="30" Cursor="Hand" Click="BtnAddCustomer_Click" Margin="0,0,5,0"
                                Background="{DynamicResource SuccessBgBrush}" BorderThickness="0" ToolTip="{DynamicResource AddCustomer}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="{StaticResource SuccessBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="btnHeldSales" Grid.Column="3" FontSize="11" Padding="8,5" Margin="0,0,10,0"
                                Cursor="Hand" Click="BtnHeldSales_Click" Visibility="Collapsed"
                                Background="{DynamicResource WarningBgBrush}" Foreground="{DynamicResource WarningTextBrush}" BorderThickness="0"/>
                        <TextBlock x:Name="txtPrevBalance" Grid.Column="4" FontSize="11" Foreground="{StaticResource WarningBrush}"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <!-- Search Bar -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="10" Margin="0,0,0,10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="1" Opacity="0.05" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Product name search -->
                        <Grid Grid.Column="0">
                            <TextBox x:Name="txtSearch" FontSize="14" Padding="38,8,10,8"
                                     TextChanged="TxtSearch_TextChanged"
                                     Tag="{DynamicResource SearchProducts}"/>
                            <materialDesign:PackIcon Kind="Magnify" Width="19" Height="19"
                                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                                     Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Barcode scanner input + camera scan -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal">
                            <Grid>
                                <TextBox x:Name="txtBarcode" FontSize="14" Padding="38,8,10,8" Width="230"
                                         KeyDown="TxtBarcode_KeyDown"
                                         Tag="{DynamicResource ScanBarcode}"/>
                                <materialDesign:PackIcon Kind="BarcodeScan" Width="19" Height="19"
                                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                                         Foreground="{DynamicResource PrimaryBrush}" IsHitTestVisible="False"/>
                            </Grid>
                            <Button x:Name="btnCameraScan" Click="BtnCameraScan_Click" Cursor="Hand" Margin="8,0,0,0"
                                    Padding="12,8" ToolTip="{DynamicResource ScanWithCamera}"
                                    Background="{DynamicResource InfoBgBrush}" Foreground="{DynamicResource InfoTextBrush}" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Camera" Width="17" Height="17" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource ScanWithCamera}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Last-scan feedback: product name / price / stock / barcode (or a not-found notice) -->
                <Border x:Name="scanInfoBorder" DockPanel.Dock="Top" CornerRadius="10" Padding="10,7" Margin="0,0,0,10"
                        Visibility="Collapsed" Background="{DynamicResource SuccessBgBrush}">
                    <TextBlock x:Name="txtScanInfo" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource SuccessTextBrush}"/>
                </Border>

                <!-- Category Filter (built dynamically in code-behind from real categories) -->
                <Border DockPanel.Dock="Top" Background="Transparent" Margin="0,0,0,8">
                    <StackPanel x:Name="categoryFilterPanel" Orientation="Horizontal"/>
                </Border>

                <!-- Product Cards -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="productCardsPanel" Margin="5">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Width-only resize handle for the cart. Height never changes. -->
        <GridSplitter x:Name="cartSplitter" Grid.Column="1" Width="6" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                      Background="{DynamicResource BorderBrush}" Cursor="SizeWE"
                      DragCompleted="CartSplitter_DragCompleted"/>

        <!-- RIGHT: Cart -->
        <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <!-- Cart Header -->
                <Border DockPanel.Dock="Top" Padding="15,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1565C0" Offset="0"/>
                            <GradientStop Color="#0D47A1" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Cart}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="txtCartCount" Text="0 items" FontSize="11" Foreground="#BBDEFB"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource ClearCart}" FontSize="11" Padding="8,5"
                                Click="BtnClearCart_Click" Background="#0D47A1" Foreground="White" BorderThickness="0"
                                Cursor="Hand" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Payment Footer -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource LightBgBrush}" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <!-- Totals -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Subtotal}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="txtSubtotal" Grid.Column="1" Text="Rs. 0" FontSize="13" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Discount}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtDiscountPercent" Width="55" FontSize="13" Padding="6,4" Text="0"
                                         HorizontalContentAlignment="Center" TextChanged="TxtDiscount_Changed" VerticalAlignment="Center"/>
                                <Border Margin="8,0,0,0" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnDiscountPercentMode" Content="%" FontSize="11" FontWeight="SemiBold" Padding="10,4"
                                                Click="BtnDiscountPercentMode_Click" BorderThickness="0" Cursor="Hand"/>
                                        <Button x:Name="btnDiscountFixedMode" Content="Rs." FontSize="11" FontWeight="SemiBold" Padding="10,4"
                                                Click="BtnDiscountFixedMode_Click" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="txtDiscountAmount" Grid.Column="1" Text="- Rs. 0" FontSize="12"
                                       Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                        </Grid>
                        <Separator Margin="0,5"/>
                        <Grid Margin="0,5,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource GrandTotal}" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="txtGrandTotal" Grid.Column="1" Text="Rs. 0" FontSize="18"
                                       FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>

                        <!-- Payment -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource PaidAmount}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtPaidAmount" Grid.Column="1" Width="120" FontSize="14" Padding="8,5"
                                     Text="0" HorizontalContentAlignment="Right"/>
                        </Grid>

                        <!-- Payment Method -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="rbCash" Content="{DynamicResource Cash}" IsChecked="True"
                                         GroupName="Payment" FontSize="12" Margin="0,0,15,0" Checked="PaymentMethod_Changed"/>
                            <RadioButton x:Name="rbCredit" Content="{DynamicResource Credit}"
                                         GroupName="Payment" FontSize="12" Margin="0,0,15,0" Checked="PaymentMethod_Changed"/>
                            <RadioButton x:Name="rbPartial" Content="{DynamicResource Partial}"
                                         GroupName="Payment" FontSize="12" Checked="PaymentMethod_Changed"/>
                        </StackPanel>

                        <Grid x:Name="pnlRemaining" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource RemainingAmount}" FontSize="12"
                                       Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtRemaining" Grid.Column="1" Text="Rs. 0" FontSize="14"
                                       FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                        </Grid>

                        <Grid x:Name="pnlDueDate" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource DueDateOptional}" FontSize="12" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpDueDate" Grid.Column="1" Width="130" FontSize="12"/>
                        </Grid>

                        <!-- Complete Sale Button -->
                        <Button x:Name="btnCompleteSale" Content="{DynamicResource CompleteSale}"
                                FontSize="15" FontWeight="Bold" Height="45" Click="BtnCompleteSale_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#4CAF50" Offset="0"/>
                                                <GradientStop Color="#388E3C" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="#2E7D32"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource DisabledBgBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Cart Items -->
                <DataGrid x:Name="dgCart" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                          HeadersVisibility="Column" CanUserAddRows="False" MinRowHeight="30"
                          CellStyle="{StaticResource CartCell}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" RowBackground="Transparent" AlternatingRowBackground="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Product}" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTemplateColumn Header="{DynamicResource Quantity}" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="-" Style="{StaticResource CartStepperBtn}" Click="BtnQtyDecrease_Click" Tag="{Binding}"/>
                                        <TextBox Text="{Binding Quantity, Mode=OneWay, StringFormat='{}{0:0.##}'}" Width="38"
                                                 Style="{StaticResource CartCellTextBox}" Tag="{Binding}" LostFocus="TxtQty_LostFocus" Margin="2,0"/>
                                        <Button Content="+" Style="{StaticResource CartStepperBtn}" Click="BtnQtyIncrease_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Price}" Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Price, Mode=OneWay, StringFormat='{}{0:0.##}'}"
                                             Style="{StaticResource CartCellTextBox}" Tag="{Binding}" LostFocus="TxtPrice_LostFocus"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Discount}" Width="55">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DiscountAmount, Mode=OneWay, StringFormat='{}{0:0.##}'}"
                                             Style="{StaticResource CartCellTextBox}" Tag="{Binding}" LostFocus="TxtItemDiscount_LostFocus"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource Total}" Binding="{Binding Total, StringFormat='Rs. {0:0.##}'}" Width="90" IsReadOnly="True"/>
                        <DataGridTemplateColumn Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Click="BtnRemoveItem_Click" Tag="{Binding}" Padding="0">
                                        <materialDesign:PackIcon Kind="CloseCircleOutline" Width="15" Height="15" Foreground="{StaticResource DangerBrush}"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty Cart Message -->
                <TextBlock x:Name="txtEmptyCart" Text="{DynamicResource EmptyCart}" FontSize="14"
                           Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
