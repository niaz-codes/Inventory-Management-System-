<UserControl x:Class="NHi.Inventory.Views.Settings.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel MaxWidth="500" HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource BackupRestore}" FontSize="22" FontWeight="Bold" Margin="0,10,0,20"/>
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource BackupDatabase}" FontSize="16" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,12"/>
                    <TextBlock Text="Create a backup of your database to a safe location." FontSize="12" Foreground="#757575" Margin="0,0,0,12"/>
                    <Button Content="{DynamicResource BackupDatabase}" Height="42" FontSize="14" Click="BtnBackup" Background="#1565C0" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource RestoreDatabase}" FontSize="16" FontWeight="SemiBold" Foreground="#F44336" Margin="0,0,0,12"/>
                    <TextBlock Text="Warning: This will replace all current data." FontSize="12" Foreground="#F44336" Margin="0,0,0,12"/>
                    <Button Content="{DynamicResource RestoreDatabase}" Height="42" FontSize="14" Click="BtnRestore" Background="#F44336" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
