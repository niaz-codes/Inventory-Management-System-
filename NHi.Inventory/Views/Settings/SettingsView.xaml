<UserControl x:Class="NHi.Inventory.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="600" HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource Settings}" FontSize="22" FontWeight="Bold" Margin="0,10,0,20"/>
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource CompanyProfile}" FontSize="16" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource ShopName}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtCompanyName" FontSize="13" Padding="10,8" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource PhoneNumber}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtPhone" FontSize="13" Padding="10,8" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Address}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtAddress" FontSize="13" Padding="10,8" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource City}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtCity" FontSize="13" Padding="10,8" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Email}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtEmail" FontSize="13" Padding="10,8" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Currency}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtCurrency" FontSize="13" Padding="10,8" Text="Rs." Margin="0,0,0,12"/>
                    <TextBlock x:Name="txtReadOnlyNotice" Text="{DynamicResource AdminPermissionRequired}" FontSize="11"
                               Foreground="#F44336" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <Button x:Name="btnSaveCompany" Content="{DynamicResource SaveChanges}" Height="38" Click="BtnSaveCompany" Background="#1565C0" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ChangePassword}" FontSize="16" FontWeight="SemiBold" Foreground="#FF9800" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource Password}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <PasswordBox x:Name="txtCurrentPass" FontSize="13" Padding="10,8" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource NewPassword}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <PasswordBox x:Name="txtNewPass" FontSize="13" Padding="10,8" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource ConfirmPassword}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <PasswordBox x:Name="txtConfirmPass" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>
                    <Button Content="{DynamicResource Save}" Height="38" Click="BtnChangePassword" Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Language" FontSize="16" FontWeight="SemiBold" Foreground="#4CAF50" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="rbEnglish" Content="English" IsChecked="True" GroupName="Lang" FontSize="13" Margin="0,0,20,0" Checked="Lang_Changed"/>
                        <RadioButton x:Name="rbUrdu" Content="اردو" GroupName="Lang" FontSize="13" Checked="Lang_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
