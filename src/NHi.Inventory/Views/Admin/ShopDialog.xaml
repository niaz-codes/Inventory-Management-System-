<Window x:Class="NHi.Inventory.Views.Admin.ShopDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shop" Height="820" Width="480" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource CardBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBrush}">
        <Border Padding="25" Width="430">
            <StackPanel>
                <TextBlock x:Name="txtTitle" Text="{DynamicResource AddShop}" FontSize="18" FontWeight="Bold"
                           Foreground="#1565C0" Margin="0,0,0,15"/>

                <TextBlock Text="{DynamicResource ShopName}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtName" FontSize="13" Padding="10,8" Margin="0,0,0,10"/>

                <TextBlock Text="{DynamicResource OwnerName}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtOwnerName" FontSize="13" Padding="10,8" Margin="0,0,0,10"/>

                <TextBlock Text="{DynamicResource BusinessType}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtBusinessType" FontSize="13" Padding="10,8" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="{DynamicResource Phone}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtPhone" FontSize="13" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource City}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtCity" FontSize="13" Padding="10,8"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource Address}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,3"/>
                <TextBox x:Name="txtAddress" FontSize="13" Padding="10,8" Margin="0,0,0,10"/>

                <TextBlock Text="{DynamicResource Email}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtEmail" FontSize="13" Padding="10,8" Margin="0,0,0,10"/>

                <TextBlock Text="{DynamicResource Currency}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtCurrency" Text="Rs." FontSize="13" Padding="10,8" Margin="0,0,0,10"/>

                <TextBlock Text="{DynamicResource ProductImage}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                        <Image x:Name="imgLogoPreview" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="btnChooseLogo" Content="{DynamicResource ProductImage}" Click="BtnChooseLogo_Click"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="panelLoginAccount">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>
                    <TextBlock Text="{DynamicResource Login}" FontSize="14" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,10"/>

                    <TextBlock Text="{DynamicResource Username}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtLoginUsername" FontSize="13" Padding="10,8" Margin="0,0,0,10"/>

                    <TextBlock Text="{DynamicResource Password}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <PasswordBox x:Name="txtLoginPassword" FontSize="13" Padding="10,8" Margin="0,0,0,10"/>

                    <TextBlock Text="{DynamicResource ConfirmPassword}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <PasswordBox x:Name="txtLoginPasswordConfirm" FontSize="13" Padding="10,8" Margin="0,0,0,10"/>

                    <TextBlock Text="{DynamicResource AccountStatus}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cmbAccountStatus" Padding="8,6" Margin="0,0,0,15" SelectedIndex="0">
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Inactive"/>
                        <ComboBoxItem Content="Pending"/>
                    </ComboBox>
                </StackPanel>

                <Button x:Name="btnSave" Content="{DynamicResource Save}" Height="40" FontSize="14" FontWeight="SemiBold"
                        Click="BtnSave_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
