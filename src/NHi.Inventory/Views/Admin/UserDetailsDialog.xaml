<Window x:Class="NHi.Inventory.Views.Admin.UserDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Details" Height="600" Width="460" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource CardBrush}">
    <Window.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="25">
            <StackPanel>
                <TextBlock Text="{DynamicResource UserDetails}" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,10"/>

                <Border Background="{DynamicResource InfoBgBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                    <TextBlock x:Name="txtStatusBadge" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InfoTextBrush}"/>
                </Border>

                <TextBlock Text="{DynamicResource ShopName}" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="txtShopName" Style="{StaticResource DetailValue}"/>

                <TextBlock Text="{DynamicResource OwnerName}" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="txtOwnerName" Style="{StaticResource DetailValue}"/>

                <TextBlock Text="{DynamicResource Username}" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="txtUsername" Style="{StaticResource DetailValue}"/>

                <TextBlock Text="{DynamicResource Phone}" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="txtPhone" Style="{StaticResource DetailValue}"/>

                <TextBlock Text="{DynamicResource Address}" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="txtAddress" Style="{StaticResource DetailValue}" TextWrapping="Wrap"/>

                <TextBlock Text="{DynamicResource Permissions}" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="txtRole" Style="{StaticResource DetailValue}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource CreatedDate}" Style="{StaticResource DetailLabel}"/>
                        <TextBlock x:Name="txtCreatedDate" Style="{StaticResource DetailValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource LastLogin}" Style="{StaticResource DetailLabel}"/>
                        <TextBlock x:Name="txtLastLogin" Style="{StaticResource DetailValue}"/>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,18,0,0">
                    <Button x:Name="btnApprove" Content="{DynamicResource Approve}" Click="BtnApprove_Click" Style="{StaticResource ActionBtn}" Background="{DynamicResource SuccessBgBrush}" Foreground="{DynamicResource SuccessTextBrush}"/>
                    <Button x:Name="btnReject" Content="{DynamicResource Reject}" Click="BtnReject_Click" Style="{StaticResource ActionBtn}" Background="{DynamicResource DangerBgBrush}" Foreground="{DynamicResource DangerTextBrush}"/>
                    <Button x:Name="btnToggleActive" Click="BtnToggleActive_Click" Style="{StaticResource ActionBtn}" Background="{DynamicResource WarningBgBrush}" Foreground="#EF6C00"/>
                    <Button Content="{DynamicResource EditUser}" Click="BtnEdit_Click" Style="{StaticResource ActionBtn}" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="{DynamicResource ResetPassword}" Click="BtnResetPassword_Click" Style="{StaticResource ActionBtn}" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="{DynamicResource ViewActivityLog}" Click="BtnActivityLog_Click" Style="{StaticResource ActionBtn}" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="{DynamicResource DeleteUser}" Click="BtnDelete_Click" Style="{StaticResource ActionBtn}" Background="{DynamicResource DangerBgBrush}" Foreground="{DynamicResource DangerTextBrush}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
