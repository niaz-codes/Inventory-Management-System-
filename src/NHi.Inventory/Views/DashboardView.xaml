<UserControl x:Class="NHi.Inventory.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewsReports="clr-namespace:NHi.Inventory.Views.Reports"
             xmlns:viewsMore="clr-namespace:NHi.Inventory.Views.More"
             Focusable="True" PreviewKeyDown="Dashboard_PreviewKeyDown">
    <UserControl.Resources>
        <!-- x:Shared="False" => every card gets its own transform/effect instance, so the
             per-card hover / press / entrance storyboards animate independently. -->
        <TransformGroup x:Key="DashCardTransform" x:Shared="False">
            <ScaleTransform ScaleX="1" ScaleY="1"/>
            <TranslateTransform X="0" Y="0"/>
        </TransformGroup>
        <DropShadowEffect x:Key="DashCardShadow" x:Shared="False" BlurRadius="22" ShadowDepth="3" Opacity="0.07" Color="#000"/>

        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="{StaticResource DashCardTransform}"/>
            <Setter Property="Effect" Value="{StaticResource DashCardShadow}"/>
            <Style.Triggers>
                <!-- Entrance: fade + gentle rise as each card mounts. -->
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                             From="22" To="0" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <!-- Hover: subtle lift + brand border + deeper shadow. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.16"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.16"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.2" Duration="0:0:0.16"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)" To="6" Duration="0:0:0.16"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.07" Duration="0:0:0.22"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)" To="3" Duration="0:0:0.22"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <!-- Press: quick tactile dip (meaningful on the clickable Low-Stock card). -->
                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.98" Duration="0:0:0.09" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="0.98" Duration="0:0:0.09" AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="DashValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="DashAccentBar" TargetType="Border">
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="13,13,0,0"/>
        </Style>
        <Style x:Key="DashIconBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- ===== Dashboard calculator ===== -->
        <Style x:Key="CalcCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Width" Value="330"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.07" Color="#000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base calculator button: rounded, themed, with a springy press animation.
             The ScaleTransform lives inside the template so every button gets its own. -->
        <Style x:Key="CalcBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.7"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.7"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CalcOpBtn" TargetType="Button" BasedOn="{StaticResource CalcBtn}">
            <Setter Property="Background" Value="{DynamicResource InfoBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}"/>
            <Setter Property="FontSize" Value="19"/>
        </Style>
        <Style x:Key="CalcEqBtn" TargetType="Button" BasedOn="{StaticResource CalcBtn}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>
        <Style x:Key="CalcClearBtn" TargetType="Button" BasedOn="{StaticResource CalcBtn}">
            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
        <StackPanel Margin="10">
            <!-- Greeting -->
            <TextBlock x:Name="txtGreeting" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="5,0,0,5"/>
            <TextBlock x:Name="txtDate" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,22"/>

            <!-- This Month -->
            <TextBlock Text="{DynamicResource ThisMonth}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="12,0,0,10"/>
            <UniformGrid Columns="6" Rows="1">
                <!-- Monthly Sales -->
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1565C0" Offset="0"/>
                                    <GradientStop Color="#42A5F5" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E3F2FD" Offset="0"/>
                                            <GradientStop Color="#BBDEFB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource MonthlySales}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtMonthlySales" Text="Rs. 0" Style="{StaticResource DashValue}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" ToolTip="{DynamicResource VsLastMonth}">
                                <materialDesign:PackIcon x:Name="iconMonthlySalesTrend" Kind="TrendingNeutral" Width="12" Height="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtMonthlySalesTrend" Text="0%" FontSize="10" FontWeight="SemiBold" Margin="2,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource VsLastMonth}" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Monthly Purchases -->
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#283593" Offset="0"/>
                                    <GradientStop Color="#7986CB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E8EAF6" Offset="0"/>
                                            <GradientStop Color="#C5CAE9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="Cart" Width="20" Height="20" Foreground="#283593" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource MonthlyPurchases}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtMonthlyPurchases" Text="Rs. 0" Style="{StaticResource DashValue}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" ToolTip="{DynamicResource VsLastMonth}">
                                <materialDesign:PackIcon x:Name="iconMonthlyPurchasesTrend" Kind="TrendingNeutral" Width="12" Height="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtMonthlyPurchasesTrend" Text="0%" FontSize="10" FontWeight="SemiBold" Margin="2,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource VsLastMonth}" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Monthly Profit -->
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2E7D32" Offset="0"/>
                                    <GradientStop Color="#66BB6A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E8F5E9" Offset="0"/>
                                            <GradientStop Color="#C8E6C9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource MonthlyProfit}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtMonthlyProfit" Text="Rs. 0" Style="{StaticResource DashValue}" Foreground="#4CAF50"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" ToolTip="{DynamicResource VsLastMonth}">
                                <materialDesign:PackIcon x:Name="iconMonthlyProfitTrend" Kind="TrendingNeutral" Width="12" Height="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtMonthlyProfitTrend" Text="0%" FontSize="10" FontWeight="SemiBold" Margin="2,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource VsLastMonth}" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Monthly Expenses -->
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#C62828" Offset="0"/>
                                    <GradientStop Color="#EF5350" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFEBEE" Offset="0"/>
                                            <GradientStop Color="#FFCDD2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="CashRemove" Width="20" Height="20" Foreground="#C62828" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource MonthlyExpenses}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtMonthlyExpenses" Text="Rs. 0" Style="{StaticResource DashValue}" Foreground="#F44336"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" ToolTip="{DynamicResource VsLastMonth}">
                                <materialDesign:PackIcon x:Name="iconMonthlyExpensesTrend" Kind="TrendingNeutral" Width="12" Height="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtMonthlyExpensesTrend" Text="0%" FontSize="10" FontWeight="SemiBold" Margin="2,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource VsLastMonth}" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Monthly Records -->
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#6A1B9A" Offset="0"/>
                                    <GradientStop Color="#AB47BC" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F3E5F5" Offset="0"/>
                                            <GradientStop Color="#E1BEE7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="20" Height="20" Foreground="#6A1B9A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource MonthlyRecords}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtMonthlyRecords" Text="0" Style="{StaticResource DashValue}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" ToolTip="{DynamicResource VsLastMonth}">
                                <materialDesign:PackIcon x:Name="iconMonthlyRecordsTrend" Kind="TrendingNeutral" Width="12" Height="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtMonthlyRecordsTrend" Text="0%" FontSize="10" FontWeight="SemiBold" Margin="2,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource VsLastMonth}" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Today -->
            <TextBlock Text="{DynamicResource Today}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="12,24,0,10"/>
            <UniformGrid Columns="6">
                <!-- Today's Sales -->
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1565C0" Offset="0"/>
                                    <GradientStop Color="#42A5F5" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E3F2FD" Offset="0"/>
                                            <GradientStop Color="#BBDEFB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource TodaysSales}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtTodaySales" Text="Rs. 0" Style="{StaticResource DashValue}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Today's Profit -->
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2E7D32" Offset="0"/>
                                    <GradientStop Color="#66BB6A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E8F5E9" Offset="0"/>
                                            <GradientStop Color="#C8E6C9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="TrendingUp" Width="20" Height="20" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource TodaysProfit}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtTodayProfit" Text="Rs. 0" Style="{StaticResource DashValue}" Foreground="#4CAF50"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Customer Receivables -->
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E65100" Offset="0"/>
                                    <GradientStop Color="#FFB74D" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFF3E0" Offset="0"/>
                                            <GradientStop Color="#FFE0B2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="20" Height="20" Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource CustomerReceivables}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtReceivables" Text="Rs. 0" Style="{StaticResource DashValue}" Foreground="#FF9800"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Supplier Payables -->
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#AD1457" Offset="0"/>
                                    <GradientStop Color="#F06292" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FCE4EC" Offset="0"/>
                                            <GradientStop Color="#F8BBD0" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="TrayArrowUp" Width="20" Height="20" Foreground="#AD1457" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource SupplierPayables}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtPayables" Text="Rs. 0" Style="{StaticResource DashValue}" Foreground="#F44336"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Today's Purchases -->
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#283593" Offset="0"/>
                                    <GradientStop Color="#7986CB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E8EAF6" Offset="0"/>
                                            <GradientStop Color="#C5CAE9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="Cart" Width="20" Height="20" Foreground="#283593" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource TodaysPurchases}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtTodayPurchases" Text="Rs. 0" Style="{StaticResource DashValue}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Today's Expenses -->
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#C62828" Offset="0"/>
                                    <GradientStop Color="#EF5350" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFEBEE" Offset="0"/>
                                            <GradientStop Color="#FFCDD2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="CashRemove" Width="20" Height="20" Foreground="#C62828" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource TodaysExpenses}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtTodayExpenses" Text="Rs. 0" Style="{StaticResource DashValue}" Foreground="#F44336"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Current Cash -->
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00695C" Offset="0"/>
                                    <GradientStop Color="#4DB6AC" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E0F7FA" Offset="0"/>
                                            <GradientStop Color="#B2EBF2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="Wallet" Width="20" Height="20" Foreground="#00695C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource CurrentCash}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtCurrentCash" Text="Rs. 0" Style="{StaticResource DashValue}" Foreground="#00897B"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Low Stock -->
                <Border Style="{StaticResource DashCard}" Cursor="Hand" MouseLeftButtonDown="LowStock_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F57F17" Offset="0"/>
                                    <GradientStop Color="#FFCA28" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFF9C4" Offset="0"/>
                                            <GradientStop Color="#FFF59D" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#F57F17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource LowStockProducts}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtLowStock" Text="0" Style="{StaticResource DashValue}" Foreground="#FF9800"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Total Products -->
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0D47A1" Offset="0"/>
                                    <GradientStop Color="#5C9CE6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E3F2FD" Offset="0"/>
                                            <GradientStop Color="#BBDEFB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="20" Height="20" Foreground="#0D47A1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource TotalProducts}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtTotalProducts" Text="0" Style="{StaticResource DashValue}" Foreground="#1565C0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0D47A1" Offset="0"/>
                                    <GradientStop Color="#5C9CE6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E3F2FD" Offset="0"/>
                                            <GradientStop Color="#BBDEFB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="AccountOutline" Width="20" Height="20" Foreground="#0D47A1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource TotalCustomers}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtTotalCustomers" Text="0" Style="{StaticResource DashValue}" Foreground="#1565C0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashAccentBar}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0D47A1" Offset="0"/>
                                    <GradientStop Color="#5C9CE6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DashIconBadge}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E3F2FD" Offset="0"/>
                                            <GradientStop Color="#BBDEFB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="TruckDeliveryOutline" Width="20" Height="20" Foreground="#0D47A1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource TotalSuppliers}" Style="{StaticResource DashLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtTotalSuppliers" Text="0" Style="{StaticResource DashValue}" Foreground="#1565C0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ===== Calculator ===== -->
            <TextBlock Text="{DynamicResource Calculator}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="12,26,0,10"/>
            <Border Style="{StaticResource CalcCard}">
                <StackPanel>
                    <!-- Display -->
                    <Border Background="{DynamicResource InputBgBrush}" CornerRadius="12" Padding="16,12" Margin="4,0,4,10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="calcExpr" Text="" FontSize="12" MinHeight="15"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="calcDisplay" Text="0" FontSize="30" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Keypad -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource CalcClearBtn}" Content="C" Tag="C" Click="CalcButton_Click"/>
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource CalcBtn}" Content="&#x232B;" Tag="back" Click="CalcButton_Click" Foreground="{DynamicResource WarningTextBrush}"/>
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource CalcOpBtn}" Content="%" Tag="%" Click="CalcButton_Click"/>
                        <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource CalcOpBtn}" Content="&#xF7;" Tag="/" Click="CalcButton_Click"/>

                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CalcBtn}" Content="7" Tag="7" Click="CalcButton_Click"/>
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CalcBtn}" Content="8" Tag="8" Click="CalcButton_Click"/>
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CalcBtn}" Content="9" Tag="9" Click="CalcButton_Click"/>
                        <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource CalcOpBtn}" Content="&#xD7;" Tag="*" Click="CalcButton_Click"/>

                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource CalcBtn}" Content="4" Tag="4" Click="CalcButton_Click"/>
                        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource CalcBtn}" Content="5" Tag="5" Click="CalcButton_Click"/>
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource CalcBtn}" Content="6" Tag="6" Click="CalcButton_Click"/>
                        <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource CalcOpBtn}" Content="&#x2212;" Tag="-" Click="CalcButton_Click"/>

                        <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource CalcBtn}" Content="1" Tag="1" Click="CalcButton_Click"/>
                        <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource CalcBtn}" Content="2" Tag="2" Click="CalcButton_Click"/>
                        <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource CalcBtn}" Content="3" Tag="3" Click="CalcButton_Click"/>
                        <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource CalcOpBtn}" Content="+" Tag="+" Click="CalcButton_Click"/>

                        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CalcBtn}" Content="0" Tag="0" Click="CalcButton_Click"/>
                        <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource CalcBtn}" Content="." Tag="." Click="CalcButton_Click"/>
                        <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource CalcEqBtn}" Content="=" Tag="=" Click="CalcButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
