<Window x:Class="NHi.Inventory.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="NHI Inventory Management System"
        Height="780" Width="1300" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource LightBgBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="LoginTextBox" TargetType="Control">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource LoginTextBox}">
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource FocusBrush}"/>
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource LoginTextBox}">
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="EyeToggleButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>

        <!-- Login Form Panel -->
        <Grid Grid.Column="1" Background="{DynamicResource LightBgBrush}">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="45,40" MaxWidth="400"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.1" Color="#000"/>
                </Border.Effect>
                <StackPanel MinWidth="300">
                    <TextBlock Text="Welcome back" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Sign in to continue to your shop" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,28"/>

                    <!-- Username -->
                    <TextBlock Text="{DynamicResource Username}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="txtUsername"/>

                    <!-- Password -->
                    <TextBlock Text="{DynamicResource Password}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Grid Margin="0,0,0,16">
                        <PasswordBox x:Name="txtPassword" Padding="14,12,44,12" Margin="0"/>
                        <TextBox x:Name="txtPasswordVisible" Padding="14,12,44,12" Margin="0" Visibility="Collapsed"/>
                        <Button x:Name="btnToggleEye" Style="{StaticResource EyeToggleButton}"
                                HorizontalAlignment="Right" Margin="0,0,4,0" Click="BtnToggleEye_Click"
                                ToolTip="{DynamicResource ShowPassword}">
                            <materialDesign:PackIcon x:Name="iconEye" Kind="EyeOutline" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <!-- Remember Me -->
                    <CheckBox x:Name="chkRemember" Content="{DynamicResource RememberMe}"
                              Margin="0,0,0,22" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <!-- Login Button -->
                    <Button x:Name="btnLogin" Content="{DynamicResource Login}" FontSize="15" FontWeight="SemiBold"
                            Height="46" Cursor="Hand" Click="BtnLogin_Click" IsDefault="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1565C0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#0D47A1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Error Message -->
                    <TextBlock x:Name="txtError" Text="" Foreground="{DynamicResource DangerTextBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"/>

                    <!-- Language Selector -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="0,24,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Language:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                            <RadioButton x:Name="rbEnglish" Content="English" IsChecked="True" GroupName="Lang"
                                         FontSize="12" VerticalAlignment="Center" Margin="0,0,15,0" Click="Lang_Changed"/>
                            <RadioButton x:Name="rbUrdu" Content="اردو" GroupName="Lang"
                                         FontSize="12" VerticalAlignment="Center" Click="Lang_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hero / Branding Panel -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1565C0" Offset="0"/>
                    <GradientStop Color="#0D47A1" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel x:Name="brandingPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="440" Margin="40" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="24"/>
                    </StackPanel.RenderTransform>
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="24" To="0" Duration="0:0:0.6" BeginTime="0:0:0.1">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </StackPanel.Triggers>

                    <Border HorizontalAlignment="Left" Width="88" Height="88" Margin="0,0,0,24"
                            Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="0.4" ScaleY="0.4"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Entrance: fade + "pop" scale-in with a slight overshoot -->
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0.4" To="1" Duration="0:0:0.6">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0.4" To="1" Duration="0:0:0.6">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <!-- Then a slow, subtle continuous "breathing" pulse once it settles -->
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="1" To="1.06" Duration="0:0:1.6" BeginTime="0:0:0.6"
                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="1" To="1.06" Duration="0:0:1.6" BeginTime="0:0:0.6"
                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Image Source="pack://application:,,,/Resources/CompanyLogo.png" Stretch="Uniform"/>
                    </Border>

                    <TextBlock Text="NHI Inventory Management System" FontSize="30" FontWeight="Bold" Foreground="White"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <TextBlock Text="A complete solution to manage Inventory, POS, Sales, Purchases, Stock and Customers — all from one place."
                               FontSize="14" Foreground="#CFE0F7" TextWrapping="Wrap" Opacity="0.92" Margin="0,0,0,28"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24" MinHeight="26">
                        <TextBlock x:Name="txtTyping" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="txtCursor" Text="|" FontSize="17" FontWeight="SemiBold" Foreground="White" Margin="2,0,0,0">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0" Duration="0:0:0.55" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>

                    <Border BorderBrush="#3DFFFFFF" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                        <TextBlock Text="Everything you need to manage your business in one place." FontSize="12.5"
                                   FontStyle="Italic" Foreground="#B8D2F0" TextWrapping="Wrap" Opacity="0.85"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="© NHI Inventory Management System" FontSize="11" Foreground="#B8D2F0"
                           VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Opacity="0.8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
