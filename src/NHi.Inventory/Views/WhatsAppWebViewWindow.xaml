<Window x:Class="NHi.Inventory.Views.WhatsAppWebViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="WhatsApp" Height="760" Width="920" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="#F0F2F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#075E54" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Whatsapp" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                <TextBlock Text="WhatsApp" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Browser area -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="webView"/>

            <Border x:Name="loadingPanel" Background="#F0F2F5">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Whatsapp" Width="42" Height="42" HorizontalAlignment="Center" Margin="0,0,0,14" Foreground="#25D366"/>
                    <TextBlock Text="Loading WhatsApp..." FontSize="14" Foreground="#54656F" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,16,0,0" Foreground="#25D366"/>
                </StackPanel>
            </Border>

            <Border x:Name="errorPanel" Background="#F0F2F5" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="42" Height="42" HorizontalAlignment="Center" Margin="0,0,0,14" Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock x:Name="txtError" FontSize="13" Foreground="#41525D" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button x:Name="btnRetry" Content="Retry" Click="BtnRetry_Click" Margin="0,18,0,0" Padding="18,9"
                            Background="#25D366" Foreground="White" BorderThickness="0" Cursor="Hand"
                            FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
