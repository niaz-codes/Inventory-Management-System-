<Window x:Class="NHi.Inventory.Views.Settings.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password" Height="200" Width="350" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource CardBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBrush}">
    <Border Padding="25">
        <StackPanel>
            <TextBlock Text="{DynamicResource NewPassword}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtNewPass" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>
            <Button Content="{DynamicResource Save}" Height="38" Click="BtnSave" Background="#FF9800" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>
