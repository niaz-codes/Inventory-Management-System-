<UserControl x:Class="NHi.Inventory.Views.Settings.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel MaxWidth="500" HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource BackupRestore}" FontSize="22" FontWeight="Bold" Margin="0,10,0,20"/>
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource BackupDatabase}" FontSize="16" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,12"/>
                    <TextBlock Text="Create a backup of your database to a safe location." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                    <Button Content="{DynamicResource BackupDatabase}" Height="42" FontSize="14" Click="BtnBackup" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource RestoreDatabase}" FontSize="16" FontWeight="SemiBold" Foreground="#F44336" Margin="0,0,0,12"/>
                    <TextBlock Text="Warning: This will replace all current data." FontSize="12" Foreground="#F44336" Margin="0,0,0,12"/>
                    <Button Content="{DynamicResource RestoreDatabase}" Height="42" FontSize="14" Click="BtnRestore" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
