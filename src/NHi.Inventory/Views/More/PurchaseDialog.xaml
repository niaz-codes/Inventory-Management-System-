<Window x:Class="NHi.Inventory.Views.More.PurchaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Purchase" Height="600" Width="700" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource AddPurchase}" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,15"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="{DynamicResource Supplier}" FontSize="11" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbSupplier" DisplayMemberPath="Name" Padding="8,6"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{DynamicResource InvoiceNumber}" FontSize="11" FontWeight="SemiBold"/>
                <TextBox x:Name="txtInvoice" FontSize="13" Padding="10,8"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="cmbProduct" Grid.Column="0" DisplayMemberPath="NameEnglish" Padding="8,6" SelectionChanged="CmbProduct_Changed"/>
            <TextBox x:Name="txtQty" Grid.Column="1" FontSize="13" Padding="8,6" Margin="5,0" Text="1"/>
            <TextBox x:Name="txtPrice" Grid.Column="2" FontSize="13" Padding="8,6" Margin="5,0"/>
            <Button Grid.Column="3" Content="+" Click="BtnAddItem_Click" Background="{StaticResource SuccessBrush}" Foreground="White" BorderThickness="0" Width="35" Height="35" Cursor="Hand" FontSize="16"/>
        </Grid>
        <DataGrid x:Name="dgItems" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,5"
                  GridLinesVisibility="Horizontal" FontSize="13" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='Rs. {0:N0}'}" Width="100"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='Rs. {0:N0}'}" Width="100"/>
                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><Button Content="X" Foreground="{StaticResource DangerBrush}" Background="Transparent" BorderThickness="0" Click="BtnRemove_Click" Tag="{Binding}" Cursor="Hand"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="txtTotal" Text="Total: Rs. 0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource PaidAmount}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="25,0,8,0"/>
                <TextBox x:Name="txtPaidAmount" FontSize="13" Padding="8,6" Width="120" TextChanged="TxtPaidAmount_TextChanged"/>
                <TextBlock x:Name="txtRemainingPreview" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Complete Purchase" Click="BtnComplete_Click" Height="40" FontSize="14" FontWeight="SemiBold"
                    Padding="20,0" Style="{StaticResource PrimaryButton}"/>
        </Grid>
    </Grid>
</Window>
