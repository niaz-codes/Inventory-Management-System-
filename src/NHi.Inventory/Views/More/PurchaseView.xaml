<UserControl x:Class="NHi.Inventory.Views.More.PurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Purchases}" FontSize="22" FontWeight="Bold"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource AddPurchase}" HorizontalAlignment="Right"
                    Click="BtnAdd_Click" Padding="15,7" FontSize="12" Style="{StaticResource PrimaryButton}"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource ExportToExcel}" HorizontalAlignment="Right" Margin="0,0,10,0"
                    Click="BtnExport_Click" Background="{DynamicResource SuccessBgBrush}" Foreground="{StaticResource SuccessBrush}" BorderThickness="0" Padding="15,7" Cursor="Hand" FontSize="12"/>
        </DockPanel>
        <DataGrid x:Name="dg" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" FontSize="13" CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="130"/>
                <DataGridTextColumn Header="Date" Binding="{Binding PurchaseDate, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="100"/>
                <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier.Name}" Width="*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat='Rs. {0:N0}'}" Width="110"/>
                <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat='Rs. {0:N0}'}" Width="100"/>
                <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAmount, StringFormat='Rs. {0:N0}'}" Width="100"/>
                <DataGridTemplateColumn Header="Actions" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{DynamicResource Return}" Click="BtnReturn_Click" Tag="{Binding}"
                                    Padding="8,4" Background="{DynamicResource WarningBgBrush}" Foreground="{StaticResource WarningBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
