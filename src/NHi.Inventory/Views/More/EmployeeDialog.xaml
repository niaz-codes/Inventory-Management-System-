<Window x:Class="NHi.Inventory.Views.More.EmployeeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Employee" Height="640" Width="400" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource CardBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBrush}">
    <Border Padding="25">
        <StackPanel>
            <TextBlock x:Name="txtTitle" Text="{DynamicResource AddEmployee}" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,15"/>
            <TextBlock Text="{DynamicResource EmployeeName}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtName" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>
            <TextBlock Text="{DynamicResource Position}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtPosition" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>
            <TextBlock Text="{DynamicResource Phone}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtPhone" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>
            <TextBlock Text="{DynamicResource Address}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtAddress" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>
            <TextBlock Text="{DynamicResource SalaryType}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="rbDaily" Content="{DynamicResource DailyWageOption}" GroupName="SalType" IsChecked="True"
                             FontSize="13" Margin="0,0,18,0" Checked="SalType_Changed"/>
                <RadioButton x:Name="rbMonthly" Content="{DynamicResource MonthlySalaryOption}" GroupName="SalType"
                             FontSize="13" Checked="SalType_Changed"/>
            </StackPanel>

            <StackPanel x:Name="pnlDaily">
                <TextBlock Text="{DynamicResource DailyWage}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtSalary" FontSize="13" Padding="10,8" Margin="0,0,0,15"/>
            </StackPanel>
            <StackPanel x:Name="pnlMonthly" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource MonthlySalary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtMonthly" FontSize="13" Padding="10,8" Margin="0,0,0,15"/>
            </StackPanel>

            <Button Content="{DynamicResource Save}" Height="40" Click="BtnSave_Click" Style="{StaticResource SuccessButton}"/>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>
