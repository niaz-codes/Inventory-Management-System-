<UserControl x:Class="NHi.Inventory.Views.More.CustomerListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Customers}" FontSize="22" FontWeight="Bold"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource AddCustomer}" HorizontalAlignment="Right"
                    Click="BtnAdd_Click" Style="{StaticResource PrimaryButton}" Padding="15,7" FontSize="12"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource ExportToExcel}" HorizontalAlignment="Right" Margin="0,0,10,0"
                    Click="BtnExport_Click" Style="{StaticResource SecondaryButton}" Padding="15,7" FontSize="12"/>
        </DockPanel>
        <TextBox x:Name="txtSearch" Grid.Row="1" FontSize="14" Padding="10,8" Margin="0,0,0,10" TextChanged="TxtSearch_TextChanged"/>
        <DataGrid x:Name="dg" Grid.Row="2" Style="{StaticResource ModernDataGrid}"
                  MouseDoubleClick="Dg_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2.2*" MinWidth="140"/>
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="1.1*" MinWidth="110"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2*" MinWidth="120"/>
                <DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance, StringFormat='Rs. {0:N0}'}" Width="1.1*" MinWidth="110"/>
                <DataGridTemplateColumn Header="Actions" Width="132" MinWidth="132">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                                <Button Background="Transparent" BorderThickness="0" Click="BtnView_Click" Tag="{Binding Id}"
                                        Cursor="Hand" Padding="5" ToolTip="{DynamicResource View}" Width="30" Height="30">
                                    <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16" Foreground="{DynamicResource InfoTextBrush}"/>
                                </Button>
                                <Button Background="Transparent" BorderThickness="0" Click="BtnEdit_Click" Tag="{Binding Id}"
                                        Cursor="Hand" Padding="5" ToolTip="{DynamicResource Edit}" Width="30" Height="30">
                                    <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}"/>
                                </Button>
                                <Button Background="Transparent" BorderThickness="0" Click="BtnDelete_Click" Tag="{Binding Id}"
                                        Cursor="Hand" Padding="5" ToolTip="{DynamicResource Delete}" Width="30" Height="30">
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="{DynamicResource DangerTextBrush}"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
