<UserControl x:Class="NHi.Inventory.Views.More.MoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="MenuItem" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.06" Color="#000"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="15,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1565C0"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuIconBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="900" HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource NavMore}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,20"/>
            <WrapPanel>
                <Button Style="{StaticResource MenuItem}" Width="200" Margin="8" Click="BtnCustomers_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource MenuIconBadge}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E3F2FD" Offset="0"/>
                                    <GradientStop Color="#BBDEFB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="AccountOutline" Width="20" Height="20" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel><TextBlock Text="{DynamicResource Customers}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Manage customers" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuItem}" Width="200" Margin="8" Click="BtnSuppliers_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource MenuIconBadge}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E8EAF6" Offset="0"/>
                                    <GradientStop Color="#C5CAE9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="TruckDeliveryOutline" Width="20" Height="20" Foreground="#283593" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel><TextBlock Text="{DynamicResource Suppliers}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Manage suppliers" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuItem}" Width="200" Margin="8" Click="BtnPurchases_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource MenuIconBadge}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E0F2F1" Offset="0"/>
                                    <GradientStop Color="#B2DFDB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="Cart" Width="20" Height="20" Foreground="#00695C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel><TextBlock Text="{DynamicResource Purchases}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Purchase management" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuItem}" Width="200" Margin="8" Click="BtnSalesHistory_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource MenuIconBadge}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFF3E0" Offset="0"/>
                                    <GradientStop Color="#FFE0B2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="20" Height="20" Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel><TextBlock Text="{DynamicResource SalesHistory}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="View all sales" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuItem}" Width="200" Margin="8" Click="BtnExpenses_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource MenuIconBadge}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFEBEE" Offset="0"/>
                                    <GradientStop Color="#FFCDD2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="CashRemove" Width="20" Height="20" Foreground="#C62828" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel><TextBlock Text="{DynamicResource Expenses}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Manage expenses" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuItem}" Width="200" Margin="8" Click="BtnReports_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource MenuIconBadge}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E0F7FA" Offset="0"/>
                                    <GradientStop Color="#B2EBF2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20" Foreground="#00838F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel><TextBlock Text="{DynamicResource Reports}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Sales, profit, stock" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuItem}" Width="200" Margin="8" Click="BtnDailyClosing_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource MenuIconBadge}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E8F5E9" Offset="0"/>
                                    <GradientStop Color="#C8E6C9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="20" Height="20" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel><TextBlock Text="{DynamicResource DailyClosing}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="End of day" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuItem}" Width="200" Margin="8" Click="BtnSettings_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource MenuIconBadge}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#ECEFF1" Offset="0"/>
                                    <GradientStop Color="#CFD8DC" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" Foreground="#455A64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel><TextBlock Text="{DynamicResource Settings}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="System settings" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button x:Name="btnUsers" Style="{StaticResource MenuItem}" Width="200" Margin="8" Click="BtnUsers_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource MenuIconBadge}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FCE4EC" Offset="0"/>
                                    <GradientStop Color="#F8BBD0" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="AccountMultipleOutline" Width="20" Height="20" Foreground="#AD1457" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel><TextBlock Text="{DynamicResource Users}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Manage users" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuItem}" Width="200" Margin="8" Click="BtnEmployees_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource MenuIconBadge}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFF8E1" Offset="0"/>
                                    <GradientStop Color="#FFECB3" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="AccountTieOutline" Width="20" Height="20" Foreground="#F57F17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel><TextBlock Text="{DynamicResource Employees}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Manage employees and dues" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
