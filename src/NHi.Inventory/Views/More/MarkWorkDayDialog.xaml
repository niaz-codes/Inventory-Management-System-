<Window x:Class="NHi.Inventory.Views.More.MarkWorkDayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mark Worked Day" Height="420" Width="380" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource CardBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBrush}">
    <Border Padding="25">
        <StackPanel>
            <TextBlock Text="{DynamicResource MarkWorkedDay}" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,15"/>

            <TextBlock Text="{DynamicResource Date}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DatePicker x:Name="dpDate" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <CheckBox x:Name="chkRange" Content="{DynamicResource MarkDateRange}" FontSize="12" Margin="0,0,0,12" Checked="ChkRange_Changed" Unchecked="ChkRange_Changed"/>

            <StackPanel x:Name="pnlToDate" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource To}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DatePicker x:Name="dpToDate" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>
            </StackPanel>

            <TextBlock Text="{DynamicResource Amount}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtAmount" FontSize="16" Padding="12,10" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Notes}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtNotes" FontSize="13" Padding="10,8" Margin="0,0,0,15"/>

            <Button Content="{DynamicResource Save}" Height="40" FontSize="14" FontWeight="SemiBold"
                    Click="BtnSave_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>
