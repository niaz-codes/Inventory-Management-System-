<Window x:Class="NHi.Inventory.Views.More.SaleDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sale Details" Height="560" Width="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource SaleDetails}" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="txtInvoice" FontSize="14" FontWeight="Bold"/>
                <TextBlock x:Name="txtDate" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                <TextBlock x:Name="txtCustomer" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                <TextBlock x:Name="txtMethod" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="dgItems" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" FontSize="12" CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Product}" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Quantity}" Binding="{Binding Quantity, StringFormat='{}{0:0.##}'}" Width="60"/>
                <DataGridTextColumn Header="{DynamicResource Price}" Binding="{Binding Price, StringFormat='Rs. {0:N0}'}" Width="80"/>
                <DataGridTextColumn Header="{DynamicResource Discount}" Binding="{Binding DiscountAmount, StringFormat='Rs. {0:N0}'}" Width="80"/>
                <DataGridTextColumn Header="{DynamicResource Total}" Binding="{Binding Total, StringFormat='Rs. {0:N0}'}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#1565C0" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Subtotal}" FontSize="10" Foreground="#BBDEFB"/>
                    <TextBlock x:Name="txtSubtotal" FontSize="13" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource GrandTotal}" FontSize="10" Foreground="#BBDEFB"/>
                    <TextBlock x:Name="txtGrandTotal" FontSize="13" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource PaidAmount}" FontSize="10" Foreground="#BBDEFB"/>
                    <TextBlock x:Name="txtPaid" FontSize="13" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="{DynamicResource RemainingAmount}" FontSize="10" Foreground="#BBDEFB"/>
                    <TextBlock x:Name="txtRemaining" FontSize="13" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnViewKhata" Grid.Column="0" Content="{DynamicResource ViewKhataBtn}" HorizontalAlignment="Left"
                    Padding="12,7" Click="BtnViewKhata_Click" Background="{DynamicResource InfoBgBrush}" Foreground="{DynamicResource InfoTextBrush}" BorderThickness="0" FontSize="12" Cursor="Hand"
                    Visibility="Collapsed"/>
            <Button Grid.Column="1" Content="{DynamicResource Close}" Padding="16,7" Click="BtnClose_Click"
                    FontSize="12" Style="{StaticResource SecondaryButton}"/>
        </Grid>
    </Grid>
</Window>
