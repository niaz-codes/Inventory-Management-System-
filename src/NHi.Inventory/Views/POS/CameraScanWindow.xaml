<Window x:Class="NHi.Inventory.Views.POS.CameraScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Scan Barcode with Camera" Height="580" Width="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource LightBgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource CameraScanTitle}" FontSize="17" FontWeight="Bold"
                   Foreground="#1565C0" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource SelectCamera}" VerticalAlignment="Center"
                       Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <ComboBox x:Name="cmbCamera" Grid.Column="1" FontSize="13" Padding="8,6"
                      SelectionChanged="CmbCamera_SelectionChanged"/>
            <Button Grid.Column="2" Click="BtnRefreshCameras_Click" Cursor="Hand" Margin="8,0,0,0" Padding="9,6"
                    ToolTip="{DynamicResource RefreshCameras}" Background="{DynamicResource SurfaceAltBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0">
                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/>
            </Button>
        </Grid>

        <Border Grid.Row="2" CornerRadius="12" Background="#111417" ClipToBounds="True"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Image x:Name="imgPreview" Stretch="Uniform"/>
                <TextBlock x:Name="txtStatus" Text="{DynamicResource DetectingCameras}" Foreground="White"
                           FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="20"/>
                <!-- viewfinder guide -->
                <Border x:Name="guide" Width="360" Height="150" BorderBrush="#66FFFFFF" BorderThickness="2"
                        CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" x:Name="lastScanBar" Margin="0,10,0,0" CornerRadius="8" Padding="10,7"
                Background="{DynamicResource SuccessBgBrush}" Visibility="Collapsed">
            <TextBlock x:Name="txtLastScan" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource SuccessTextBrush}"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock Text="{DynamicResource PointCameraAtBarcode}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0"/>
            <Button Content="{DynamicResource CloseScanner}" Click="BtnClose_Click" Padding="18,9"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
