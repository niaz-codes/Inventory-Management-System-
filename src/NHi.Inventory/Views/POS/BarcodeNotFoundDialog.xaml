<Window x:Class="NHi.Inventory.Views.POS.BarcodeNotFoundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Product Not Found" Height="270" Width="480" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource CardBrush}">
    <Border Padding="24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <materialDesign:PackIcon Kind="BarcodeOff" Width="26" Height="26" Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource BarcodeNotFoundMessage}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="txtBarcode" FontSize="13" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" Margin="36,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Cancel}" Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource TryAgain}" Click="BtnTryAgain_Click" Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource AddNewProduct}" Click="BtnAddNew_Click" Style="{StaticResource PrimaryButton}" Padding="18,8" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
