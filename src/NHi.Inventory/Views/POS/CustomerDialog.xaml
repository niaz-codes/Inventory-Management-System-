<Window x:Class="NHi.Inventory.Views.POS.CustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Customer" Height="640" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource CardBrush}">
    <Border Padding="25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock x:Name="txtTitle" Text="{DynamicResource AddCustomer}" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,20"/>

            <TextBlock Text="{DynamicResource CustomerName}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtName" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource FatherName}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtFatherName" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Phone}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtPhone" FontSize="13" Padding="10,8" Margin="0,0,0,8" TextChanged="TxtPhone_TextChanged"/>

            <CheckBox x:Name="chkWhatsAppSame" Content="{DynamicResource WhatsAppSameAsPhone}" FontSize="12"
                      IsChecked="True" Margin="0,0,0,8"/>

            <TextBlock x:Name="lblWhatsApp" Text="{DynamicResource WhatsAppNumber}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtWhatsApp" FontSize="13" Padding="10,8" Margin="0,0,0,12" IsEnabled="False"/>

            <TextBlock Text="{DynamicResource Address}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtAddress" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Email}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtEmail" FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="lblOpeningBalance" Text="{DynamicResource OpeningBalance}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtOpeningBalance" FontSize="13" Padding="10,8" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource CreditLimit}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCreditLimit" FontSize="13" Padding="10,8" Text="0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Notes}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtNotes" FontSize="13" Padding="10,8" Margin="0,0,0,12" TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>

            <CheckBox x:Name="chkActive" Content="{DynamicResource Active}" FontSize="13" IsChecked="True" Margin="0,0,0,18"/>

            <Button Content="{DynamicResource Save}" Height="40" FontSize="14" FontWeight="SemiBold"
                    Click="BtnSave_Click" Style="{StaticResource SuccessButton}"/>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
