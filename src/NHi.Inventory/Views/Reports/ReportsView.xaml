<UserControl x:Class="NHi.Inventory.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReportCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.06" Color="#000"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Inherit the app-wide themed DataGrid (themed Background / headers / rows / cells)
             so no default white surface bleeds through in Dark Mode. -->
        <Style x:Key="ReportDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"/>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource Reports}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Style="{StaticResource IconTabItem}">
                <TabItem.Header><TextBlock Text="{DynamicResource SalesReports}" Padding="10,5" FontSize="13" FontWeight="SemiBold"/></TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource ReportCard}" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="From" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <DatePicker x:Name="dpFrom" Grid.Column="1"/>
                            <TextBlock Grid.Column="2" Text="To" VerticalAlignment="Center" Margin="15,0,8,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <DatePicker x:Name="dpTo" Grid.Column="3"/>
                            <Button Grid.Column="4" Content="{DynamicResource Filter}" Click="BtnFilterSales" Padding="14,7" Margin="15,0,8,0"
                                    Background="#1565C0" Foreground="White" BorderThickness="0" FontSize="12" Style="{StaticResource PillButton}"/>
                            <Button Grid.Column="5" Content="{DynamicResource ExportToExcel}" Click="BtnExportSales" Padding="14,7"
                                    Background="{DynamicResource SuccessBgBrush}" Foreground="{DynamicResource SuccessTextBrush}" BorderThickness="0" FontSize="12" Style="{StaticResource PillButton}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource ReportCard}" Padding="1">
                        <DataGrid x:Name="dgSales" Style="{StaticResource ReportDataGrid}" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="130"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="100"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="*"/>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat='Rs. {0:N0}'}" Width="100"/>
                                <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat='Rs. {0:N0}'}" Width="80"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat='Rs. {0:N0}'}" Width="100"/>
                                <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat='Rs. {0:N0}'}" Width="90"/>
                                <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAmount, StringFormat='Rs. {0:N0}'}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Style="{StaticResource IconTabItem}">
                <TabItem.Header><TextBlock Text="{DynamicResource InventoryReports}" Padding="10,5" FontSize="13" FontWeight="SemiBold"/></TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource ReportCard}" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cmbStockFilter" Grid.Column="0" FontSize="12" Padding="8,6" SelectedIndex="0" SelectionChanged="StockFilter_Changed">
                                <ComboBoxItem Content="{DynamicResource All}" Tag="All"/>
                                <ComboBoxItem Content="{DynamicResource StatusLow}" Tag="LowStock"/>
                                <ComboBoxItem Content="{DynamicResource StatusExpired}" Tag="Expired"/>
                                <ComboBoxItem Content="{DynamicResource ExpiringSoon}" Tag="Expiring"/>
                            </ComboBox>
                            <Button Grid.Column="2" Content="{DynamicResource PrintReport}" Click="BtnPrintStock" Padding="14,7" Margin="10,0,0,0"
                                    Background="{DynamicResource InfoBgBrush}" Foreground="{DynamicResource InfoTextBrush}" BorderThickness="0" FontSize="12" Style="{StaticResource PillButton}"/>
                            <Button Grid.Column="3" Content="{DynamicResource ExportToExcel}" Click="BtnExportStock" Padding="14,7" Margin="10,0,0,0"
                                    Background="{DynamicResource SuccessBgBrush}" Foreground="{DynamicResource SuccessTextBrush}" BorderThickness="0" FontSize="12" Style="{StaticResource PillButton}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource ReportCard}" Padding="1">
                        <DataGrid x:Name="dgStock" Style="{StaticResource ReportDataGrid}" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource ProductName}" Binding="{Binding NameEnglish}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Barcode}" Binding="{Binding Barcode}" Width="120"/>
                                <DataGridTextColumn Header="{DynamicResource PurchasePrice}" Binding="{Binding PurchasePrice, StringFormat='Rs. {0:N0}'}" Width="100"/>
                                <DataGridTextColumn Header="{DynamicResource SalePrice}" Binding="{Binding SalePrice, StringFormat='Rs. {0:N0}'}" Width="90"/>
                                <DataGridTextColumn Header="{DynamicResource CurrentStock}" Binding="{Binding CurrentStock, StringFormat='{}{0:N0}'}" Width="80"/>
                                <DataGridTextColumn Header="{DynamicResource Unit}" Binding="{Binding Unit.Name}" Width="80"/>
                                <DataGridTextColumn Header="{DynamicResource ExpiryDate}" Binding="{Binding ExpiryDate, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="100"/>
                                <DataGridTextColumn Header="{DynamicResource StockValueColumn}" Binding="{Binding StockValue, StringFormat='Rs. {0:N0}'}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="2" CornerRadius="14" Padding="14" Margin="0,12,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1565C0" Offset="0"/>
                                <GradientStop Color="#0D47A1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.15" Color="#0D47A1"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource StockValuationByCategory}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{DynamicResource ExportToExcel}" Click="BtnExportCategoryValuation" Padding="10,5" Margin="0,0,8,0"
                                        Background="#0D47A1" Foreground="White" BorderThickness="0" FontSize="10" Style="{StaticResource PillButton}"/>
                                <Button Grid.Column="2" Content="{DynamicResource ExportAdjustmentHistory}" Click="BtnExportAdjustmentHistory" Padding="10,5"
                                        Background="#0D47A1" Foreground="White" BorderThickness="0" FontSize="10" Style="{StaticResource PillButton}"/>
                            </Grid>
                            <ItemsControl x:Name="icCategoryValuation">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding CategoryName}" Foreground="#BBDEFB" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Foreground="White" FontSize="11" FontWeight="SemiBold" Text="{Binding Summary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Style="{StaticResource IconTabItem}">
                <TabItem.Header><TextBlock Text="{DynamicResource ProfitReports}" Padding="10,5" FontSize="13" FontWeight="SemiBold"/></TabItem.Header>
                <Grid Margin="20">
                    <StackPanel MaxWidth="420" HorizontalAlignment="Center">
                        <Border Style="{StaticResource ReportCard}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Profit Summary" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InfoTextBrush}" Margin="0,0,0,16"/>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Today's Gross Profit" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock x:Name="txtGrossProfit" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}"/></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Today's Expenses" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock x:Name="txtExpenses" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DangerTextBrush}"/></Grid>
                                <Separator Margin="0,10" Background="{DynamicResource BorderBrush}"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Net Profit" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock x:Name="txtNetProfit" Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InfoTextBrush}"/></Grid>
                                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Stock Value" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock x:Name="txtStockValue" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/></Grid>
                            </StackPanel>
                        </Border>
                        <Button Content="{DynamicResource ExportToExcel}" Margin="0,16,0,0" Height="40" Click="BtnExportProfit"
                                Background="{DynamicResource SuccessBgBrush}" Foreground="{DynamicResource SuccessTextBrush}" BorderThickness="0" FontSize="12" Style="{StaticResource PillButton}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
