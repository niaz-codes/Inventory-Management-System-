<Window x:Class="NHi.Inventory.Views.Inventory.BarcodeLabelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Barcode Label" Height="420" Width="440" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource CardBrush}">
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="{DynamicResource PrintLabel}" FontSize="18" FontWeight="Bold"
                       Foreground="#1565C0" Margin="0,0,0,4"/>
            <TextBlock x:Name="txtProductName" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,2"/>
            <TextBlock x:Name="txtProductMeta" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

            <Border Background="White" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Margin="0,0,0,16">
                <Image x:Name="imgBarcode" Height="110" Stretch="Uniform"/>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Copies}" VerticalAlignment="Center" FontSize="12"
                           FontWeight="SemiBold" Margin="0,0,10,0"/>
                <TextBox x:Name="txtCopies" Text="1" Width="70" FontSize="13" Padding="8,6"
                         HorizontalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Cancel}" Click="BtnClose_Click" Style="{StaticResource SecondaryButton}"
                        Padding="16,8" Margin="0,0,10,0"/>
                <Button Content="{DynamicResource BarcodeSheet}" Click="BtnSheet_Click" Style="{StaticResource SecondaryButton}"
                        Padding="16,8" Margin="0,0,10,0"/>
                <Button Content="{DynamicResource Print}" Click="BtnPrint_Click" Style="{StaticResource PrimaryButton}"
                        Padding="20,8"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
