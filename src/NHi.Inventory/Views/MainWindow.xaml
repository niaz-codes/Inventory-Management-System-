<Window x:Class="NHi.Inventory.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:NHi.Inventory.Views"
        xmlns:viewsPOS="clr-namespace:NHi.Inventory.Views.POS"
        xmlns:viewsInv="clr-namespace:NHi.Inventory.Views.Inventory"
        xmlns:viewsKhata="clr-namespace:NHi.Inventory.Views.Khata"
        xmlns:viewsMore="clr-namespace:NHi.Inventory.Views.More"
        xmlns:viewsReports="clr-namespace:NHi.Inventory.Views.Reports"
        xmlns:viewsSettings="clr-namespace:NHi.Inventory.Views.Settings"
        Title="NHI Inventory Management System"
        Height="780" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinHeight="700" MinWidth="1100"
        Background="{DynamicResource LightBgBrush}">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{x:Static views:MainWindowCommands.NewSaleCommand}"/>
        <KeyBinding Key="F2" Command="{x:Static views:MainWindowCommands.SearchProductCommand}"/>
        <KeyBinding Key="F9" Command="{x:Static views:MainWindowCommands.PrintCommand}"/>
        <KeyBinding Key="F10" Command="{x:Static views:MainWindowCommands.CompleteSaleCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <!-- Main navigation tab: colourful always-on icon, animated hover / press / active-underline. -->
        <Style x:Key="TopTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <!-- active-tab fill (opacity driven only by IsChecked) -->
                            <Border x:Name="activeBg" Background="{DynamicResource HoverBrush}" CornerRadius="8" Margin="3,4" Opacity="0"/>
                            <!-- hover fill (opacity driven only by IsMouseOver) -->
                            <Border x:Name="hoverBg" Background="{DynamicResource HoverBrush}" CornerRadius="8" Margin="3,4" Opacity="0"/>
                            <Border Padding="15,11">
                                <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                    <ContentPresenter.RenderTransform>
                                        <ScaleTransform x:Name="cpScale" ScaleX="1" ScaleY="1"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                            <Border x:Name="underline" Height="4" VerticalAlignment="Bottom" CornerRadius="2"
                                    Background="#1565C0" Margin="12,0" RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ulScale" ScaleX="0" ScaleY="1"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverBg" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="cpScale" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="cpScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="cpScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13"/>
                                            <DoubleAnimation Storyboard.TargetName="cpScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.13"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#1565C0"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="activeBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ulScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="cpScale" Storyboard.TargetProperty="ScaleX">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.11" Value="1.14"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="cpScale" Storyboard.TargetProperty="ScaleY">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.11" Value="1.14"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="activeBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ulScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavTabLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#1565C0" Padding="15,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#0D47A1" Margin="0,0,10,0">
                        <Grid>
                            <TextBlock x:Name="txtBrandBadge" Text="NHI" FontSize="12" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="imgShopLogo" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="txtBrandName" Text="NHI Inventory" FontSize="16" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- User Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtCurrentUser" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtUserRole" Foreground="#BBDEFB" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button x:Name="btnTheme" Padding="8,6" Margin="0,0,5,0" Click="BtnTheme_Click"
                            Style="{StaticResource HeaderIconButton}" ToolTip="{DynamicResource Theme}">
                        <materialDesign:PackIcon x:Name="iconTheme" Kind="MoonWaningCrescent" Width="18" Height="18" Foreground="White"/>
                    </Button>
                    <Button Padding="8,6" Click="BtnLogout_Click" Style="{StaticResource HeaderIconButton}" ToolTip="{DynamicResource Logout}">
                        <materialDesign:PackIcon Kind="Logout" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top Tab Navigation -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" Margin="6,2">
                <RadioButton x:Name="navHome" IsChecked="True" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="Home">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Home" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#1565C0"/>
                        <TextBlock Text="{DynamicResource NavHome}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="navPOS" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="POS">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PointOfSale" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#2E7D32"/>
                        <TextBlock Text="{DynamicResource NavPOS}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="navInventory" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="Inventory">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#EF6C00"/>
                        <TextBlock Text="{DynamicResource NavInventory}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="navKhata" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="Khata">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BookOpenPageVariantOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#6A1B9A"/>
                        <TextBlock Text="{DynamicResource NavKhata}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="navCustomers" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="Customers">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#0277BD"/>
                        <TextBlock Text="{DynamicResource Customers}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="navSuppliers" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="Suppliers">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TruckDeliveryOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#283593"/>
                        <TextBlock Text="{DynamicResource Suppliers}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="navPurchases" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="Purchases">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CartOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#00695C"/>
                        <TextBlock Text="{DynamicResource Purchases}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="navSalesHistory" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="SalesHistory">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#E65100"/>
                        <TextBlock Text="{DynamicResource SalesHistory}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="navExpenses" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="Expenses">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashRemove" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#C62828"/>
                        <TextBlock Text="{DynamicResource Expenses}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="navReports" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="Reports">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#00838F"/>
                        <TextBlock Text="{DynamicResource Reports}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="navDailyClosing" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="DailyClosing">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#33691E"/>
                        <TextBlock Text="{DynamicResource DailyClosing}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="navEmployees" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="Employees">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountTieOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#F57F17"/>
                        <TextBlock Text="{DynamicResource Employees}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="navUsers" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="Users">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountMultipleOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AD1457"/>
                        <TextBlock Text="{DynamicResource Users}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="navSettings" Style="{StaticResource TopTabButton}" Click="Nav_Click" Tag="Settings">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#455A64"/>
                        <TextBlock Text="{DynamicResource Settings}" Style="{StaticResource NavTabLabel}"/>
                    </StackPanel>
                </RadioButton>
            </WrapPanel>
        </Border>

        <!-- Content Area -->
        <ContentControl x:Name="mainContent" Grid.Row="2" Margin="0" x:FieldModifier="public" RenderTransformOrigin="0.5,0.5"/>
    </Grid>
</Window>
