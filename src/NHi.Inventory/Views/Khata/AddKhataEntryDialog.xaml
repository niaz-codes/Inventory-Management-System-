<Window x:Class="NHi.Inventory.Views.Khata.AddKhataEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Khata Entry" Height="560" Width="400" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource CardBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBrush}">
    <Border Padding="25">
        <StackPanel>
            <TextBlock Text="{DynamicResource AddKhataEntry}" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,4"/>
            <TextBlock x:Name="txtCustomerName" FontSize="14" Margin="0,0,0,15"/>

            <TextBlock Text="{DynamicResource EntryType}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Margin="0,0,0,12">
                <RadioButton x:Name="rbCredit" Content="{DynamicResource CreditUdhaar}" GroupName="EntryType"
                             IsChecked="True" FontSize="13" Margin="0,0,0,6" Checked="EntryType_Changed"/>
                <RadioButton x:Name="rbPayment" Content="{DynamicResource PaymentReceivedType}" GroupName="EntryType"
                             FontSize="13" Margin="0,0,0,6" Checked="EntryType_Changed"/>
                <RadioButton x:Name="rbAdjustment" Content="{DynamicResource Adjustment}" GroupName="EntryType"
                             FontSize="13" Checked="EntryType_Changed"/>
            </StackPanel>

            <StackPanel x:Name="pnlAdjustmentDirection" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,12">
                <RadioButton x:Name="rbIncrease" Content="+" GroupName="AdjDirection" IsChecked="True" FontSize="13" Margin="0,0,20,0" FontWeight="Bold" Foreground="{DynamicResource DangerTextBrush}"/>
                <RadioButton x:Name="rbDecrease" Content="-" GroupName="AdjDirection" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}"/>
            </StackPanel>

            <TextBlock Text="{DynamicResource Amount}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtAmount" FontSize="16" Padding="12,10" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Description}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtDescription" FontSize="13" Padding="10,8" Margin="0,0,0,12" TextWrapping="Wrap" AcceptsReturn="True" Height="55"/>

            <StackPanel x:Name="pnlDueDate" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource DueDateOptional}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DatePicker x:Name="dpDueDate" FontSize="13" Padding="8,6"/>
            </StackPanel>

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock x:Name="txtCreatedBy" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="txtCreatedAt" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Button Content="{DynamicResource Save}" Height="42" FontSize="14" FontWeight="SemiBold"
                    Click="BtnSave_Click" Style="{StaticResource SuccessButton}"/>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>
