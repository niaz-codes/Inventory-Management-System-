<Window x:Class="NHi.Inventory.Views.Printing.UniversalPrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PrintPreview}" Height="820" Width="1080"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource LightBgBrush}">
    <Window.Resources>
        <Style x:Key="PagerBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="bd" Property="Background" Value="#1565C0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}" Padding="14,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="pnlPaper" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource PaperSize}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cmbPaper" Width="120" SelectionChanged="Opt_Changed" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="A4" IsSelected="True"/>
                        <ComboBoxItem Content="A5"/>
                        <ComboBoxItem Content="Letter"/>
                        <ComboBoxItem Content="{DynamicResource CustomSize}"/>
                    </ComboBox>
                    <StackPanel x:Name="pnlCustom" Orientation="Horizontal" Visibility="Collapsed" Margin="10,0,0,0">
                        <TextBox x:Name="txtCustomW" Width="52" Text="100" FontSize="12" Padding="6,4" HorizontalContentAlignment="Center" LostFocus="Opt_Changed"/>
                        <TextBlock Text="×" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBox x:Name="txtCustomH" Width="52" Text="150" FontSize="12" Padding="6,4" HorizontalContentAlignment="Center" LostFocus="Opt_Changed"/>
                        <TextBlock Text="mm" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="14,2"/>
                </StackPanel>

                <StackPanel x:Name="pnlBarcode" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource LabelSize}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtLabelW" Width="46" Text="55" FontSize="12" Padding="6,4" HorizontalContentAlignment="Center" LostFocus="Opt_Changed"/>
                    <TextBlock Text="×" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox x:Name="txtLabelH" Width="46" Text="32" FontSize="12" Padding="6,4" HorizontalContentAlignment="Center" LostFocus="Opt_Changed"/>
                    <TextBlock Text="mm" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="14,2"/>
                    <TextBlock Text="{DynamicResource Copies}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtCopies" Width="46" Text="1" FontSize="12" Padding="6,4" HorizontalContentAlignment="Center" LostFocus="Opt_Changed"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="14,2"/>
                </StackPanel>

                <Button Content="–" Click="BtnZoomOut_Click" Style="{StaticResource PagerBtn}" MinWidth="30"/>
                <TextBlock x:Name="txtZoom" Text="100%" VerticalAlignment="Center" FontSize="12" Width="46" TextAlignment="Center"/>
                <Button Content="+" Click="BtnZoomIn_Click" Style="{StaticResource PagerBtn}" MinWidth="30"/>
                <Button Content="{DynamicResource FitPage}" Click="BtnFit_Click" Style="{StaticResource PagerBtn}" Margin="8,0,0,0" Padding="10,0"/>
            </StackPanel>
        </Border>

        <!-- Pager + print controls -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}" Padding="14,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource FromPage}" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtFrom" Width="44" Text="1" FontSize="12" Padding="6,4" HorizontalContentAlignment="Center"/>
                    <TextBlock Text="{DynamicResource ToPage}" VerticalAlignment="Center" FontSize="12" Margin="8,0,6,0"/>
                    <TextBox x:Name="txtTo" Width="44" Text="1" FontSize="12" Padding="6,4" HorizontalContentAlignment="Center"/>
                    <Button Content="{DynamicResource PrintRange}" Click="BtnPrintRange_Click" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="8,0,0,0"/>
                    <Button Content="{DynamicResource PrintCurrentPage}" Click="BtnPrintCurrent_Click" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="8,0,0,0"/>
                    <Button Content="{DynamicResource PrintAllPages}" Click="BtnPrintAll_Click" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnPrev" Content="◀" Click="BtnPrev_Click" Style="{StaticResource PagerBtn}"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="360">
                        <StackPanel x:Name="pageButtons" Orientation="Horizontal"/>
                    </ScrollViewer>
                    <Button x:Name="btnNext" Content="▶" Click="BtnNext_Click" Style="{StaticResource PagerBtn}"/>
                    <TextBlock x:Name="txtPageInfo" VerticalAlignment="Center" FontSize="12" Margin="14,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Preview -->
        <ScrollViewer x:Name="previewScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource SurfaceAltBrush}" Padding="24">
            <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22" Color="#000"/>
                </Border.Effect>
                <Image x:Name="imgPreview" Stretch="Uniform" FlowDirection="LeftToRight"/>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
